    $sql = "SELECT * FROM tbl_associate WHERE Id = ?";
} else {
    die("Unknown source type.");
}

$stmt = $conn->prepare($sql);
$stmt->bind_param("i", $entity_id);
$stmt->execute();
$result = $stmt->get_result();
if ($result->num_rows === 0) {
    die(ucfirst($source_type) . " not found.");
}
$entity = $result->fetch_assoc();


 // Fetch all non-zero payments
// Fetch payments for the invoice year
$payments = [];
$total_paid = 0;
$total_invoice_amount = 0;

if ($source_type === 'placement' || $source_type === 'consultant') {

    $interview_id = (int)($invoice['placement_interview_id'] ?? 0);

    $paymentSql = "
        SELECT *
        FROM tbl_payment
        WHERE interview_id = ?
          AND YEAR(payment_date) = ?
          AND (
              COALESCE(paid_amount, 0) > 0
              OR COALESCE(tds_amount, 0) > 0
          )
          AND payment_gateway IS NOT NULL
          AND TRIM(payment_gateway) NOT IN ('', '0')
        ORDER BY payment_date ASC, Id ASC
    ";

    $paymentStmt = $conn->prepare($paymentSql);
    $paymentStmt->bind_param("ii", $interview_id, $invoice_year);

} else {

    $paymentSql = "
        SELECT *
        FROM tbl_payment
        WHERE client_Id = ?
          AND YEAR(payment_date) = ?
          AND (
              COALESCE(paid_amount, 0) > 0
              OR COALESCE(tds_amount, 0) > 0
          )
          AND payment_gateway IS NOT NULL
          AND TRIM(payment_gateway) NOT IN ('', '0')
        ORDER BY payment_date ASC, Id ASC
    ";

    $paymentStmt = $conn->prepare($paymentSql);
    $paymentStmt->bind_param("si", $entity_id, $invoice_year);
}

$paymentStmt->execute();
$paymentResult = $paymentStmt->get_result();

while ($row = $paymentResult->fetch_assoc()) {

    // Total amount from tbl_payment
    $total_invoice_amount = max(
        $total_invoice_amount,
        (float)($row['total_amount'] ?? 0)
    );

    // Add instalments paid
    $total_paid += (float)($row['paid_amount'] ?? 0)
                 + (float)($row['tds_amount'] ?? 0);

    $payments[] = $row;
}

// Calculate remaining balance
$balance_amount = $total_invoice_amount - $total_paid;


// ✅ Get Joining Date
