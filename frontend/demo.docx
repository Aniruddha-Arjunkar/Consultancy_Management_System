                                name="document"
                                id="document"
                                accept=".pdf,application/pdf"
                                required
                            >
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group full-width">
                            <button
                                type="submit"
                                class="submit-btn">
                                <span>📄</span>
                                Upload Document
                            </button>
                        </div>
                    </div>
                </form>
            </div>
