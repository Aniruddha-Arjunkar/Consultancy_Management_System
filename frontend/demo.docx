is Employee Module . Employee module have relation with Two modules Acounts Module and 
Attendance module which we going to implement after Employee module. In this Employee 
Module we can Add Employee in AppEmployee.jsx page, View employee Details (Attendance of that
employee in specific month , Upload and View Document , View Salary and Advance ,
Update Employee profile , Resignation and reason of Resignation (with status with notice
period , without noting period and Abscord)) in ViewEmployee.jsx ,  Generate Employee offer
, experiance ,intership , Appointment letter in generateLetter.jsx  add Salary of the 
Employee in Salary.jsx . Senior database schema ---> "
CREATE TABLE `employee_documents` (
  `Id` bigint(20) UNSIGNED NOT NULL,
  `employee_id` int(11) NOT NULL,
  `document_type` varchar(255) NOT NULL,
  `document_name` varchar(255) NOT NULL,
  `file_path` varchar(255) NOT NULL
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
CREATE TABLE `tbl_employee` (
  `Id` bigint(20) UNSIGNED NOT NULL,
  `title` text NOT NULL,
  `cust_name` text NOT NULL,
  `mother_name` text NOT NULL,
  `cust_phone` text NOT NULL,
  `cust_alternate` text DEFAULT NULL,
  `alternate_phone_relation` text NOT NULL,
  `cust_email` text NOT NULL,
  `cust_address1` text NOT NULL,
  `cust_address2` text NOT NULL,
  `package` text NOT NULL,
  `qualification` text NOT NULL,
  `date` date NOT NULL,
  `designation` text NOT NULL,
  `dob` date NOT NULL,
  `gender` text NOT NULL,
  `marital_status` text NOT NULL,
  `spouse_name` text DEFAULT NULL,
  `spouse_occupation` text DEFAULT NULL,
  `photo` varchar(255) NOT NULL,
  `education_10th` text NOT NULL,
  `education_12th` text NOT NULL,
  `education_graduation` text NOT NULL,
  `education_postgrad` text NOT NULL,
  `experience_fresher` text NOT NULL,
  `previous_company_name` text NOT NULL,
  `previous_experience` text NOT NULL,
  `work_experience_years` text NOT NULL,
  `adhar_no` text NOT NULL,
  `pan_card_no` text NOT NULL,
  `account_no` text NOT NULL,
  `bank_name` text NOT NULL,
  `branch_name` text NOT NULL,
  `ifsc_code` text NOT NULL,
  `employee_type` text NOT NULL,
  `department` text NOT NULL,
  `pf_uan` text NOT NULL,
  `pf_number` text NOT NULL,
  `esic_number` text NOT NULL,
  `emp_id` text DEFAULT NULL,
  `previous_designation` text NOT NULL,
  `previous_job_salary` text NOT NULL,
  `resignation_type` text DEFAULT NULL,
  `resignation_date` date DEFAULT NULL,
  `notice_period` date DEFAULT NULL,
  `release_date` date DEFAULT NULL,
  `reason_for_leaving` text DEFAULT NULL,
  `abscond_date` date DEFAULT NULL,
  `branch` enum('Nagpur','Bramhapuri','Chandrapur') DEFAULT NULL
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
CREATE TABLE `tbl_salary` (
  `Id` bigint(20) UNSIGNED NOT NULL,
  `employee_id` int(11) NOT NULL,
  `month` varchar(255) DEFAULT NULL,
  `amount` decimal(10,0) DEFAULT NULL,
  `basic` decimal(10,2) DEFAULT NULL,
  `hra` decimal(10,2) DEFAULT NULL,
  `conveyance` decimal(10,2) DEFAULT NULL,
  `food_allowance` decimal(10,2) DEFAULT 0.00,
  `performance_incentive` decimal(10,2) DEFAULT 0.00,
  `profession_tax` decimal(10,2) DEFAULT 0.00,
  `advance` decimal(10,2) DEFAULT 0.00,
  `payment_type` enum('Salary','Stipend','Advance','PerDay') NOT NULL,
  `advance_date` date DEFAULT NULL,
  `remark` varchar(255) DEFAULT NULL,
  `expense_reimbursement` decimal(10,2) DEFAULT NULL
) ENGINE=InnoDB DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
ALTER TABLE `employee_documents`
  ADD PRIMARY KEY (`Id`);
  ALTER TABLE `tbl_employee`
  ADD PRIMARY KEY (`Id`),
  ADD UNIQUE KEY `Id` (`Id`);
  ALTER TABLE `tbl_salary`
  ADD PRIMARY KEY (`Id`);"
