  require_once 'db_connect.php';
include 'header.php';
  /* =========================================
   GET DATA
========================================= */
  $client_id = $_GET['client_id'] ?? '';
$source_type = strtolower(trim($_GET['source_type'] ?? ''));
$amountFromUrl = $_GET['amount'] ?? '';
  $success = '';
$error = '';
  $gst_type_selected = $_POST['gst_type'] ?? '';
  $baseAmount = $amountFromUrl;
  $commentPrefill = '';
  $placement_interview_id = null;
  /* =========================================
   FETCH AMOUNT
========================================= */
  if (!empty($client_id) && !empty($source_type)) {
      $safe_client_id = intval($client_id);
      switch ($source_type) {
          /* =========================
           PEST CONTROL
        ========================= */
          /* =========================
           PLACEMENT
        ========================= */
          case 'placement':
              if (empty($baseAmount)) {
                  $sql = "
                    SELECT candidate_pay_amount, interview_id
                    FROM tbl_placement
                    WHERE candidate_id = $safe_client_id
                    LIMIT 1
                ";
                  $result = mysqli_query($conn, $sql);
                  if ($result && $row = mysqli_fetch_assoc($result)) {
                      $baseAmount =
                        $row['candidate_pay_amount'];
                      $placement_interview_id =
                        $row['interview_id'];
                  }
              }
              break;
          /* =========================
           CONSULTANT
        ========================= */
          case 'consultant':
              if (empty($baseAmount)) {
                  $sql = "
                    SELECT
                        p.company_pay_amount,
                        p.interview_id
                    FROM tbl_associate a
                    LEFT JOIN tbl_placement p
                        ON p.company_name = a.company_name
                    WHERE a.Id = $safe_client_id
                    LIMIT 1
                ";
                  $result = mysqli_query($conn, $sql);
                  if ($result && $row = mysqli_fetch_assoc($result)) {
                      $baseAmount =
                        $row['company_pay_amount'] ?? 0;
                      $placement_interview_id =
                        $row['interview_id'] ?? null;
                  }
              }
              break;
    }
}
  /* =========================================
   FORM SUBMIT
========================================= */
  if ($_SERVER['REQUEST_METHOD'] == 'POST') {
      $entity_id =
        intval($_POST['client_id'] ?? 0);
      $sourceType =
        mysqli_real_escape_string(
            $conn,
            $_POST['source_type'] ?? ''
        );
      $amount =
        floatval($_POST['amount'] ?? 0);
      $gst_type =
        $_POST['gst_type'] ?? '';
      $invoice_date =
        mysqli_real_escape_string(
            $conn,
            $_POST['invoice_date'] ?? ''
        );
      $comments =
        mysqli_real_escape_string(
            $conn,
            $_POST['comments'] ?? ''
        );
      $igst = 0;
      $placement_interview_id =
        !empty($_POST['placement_interview_id'])
            ? intval($_POST['placement_interview_id'])
            : null;
      $placement_interview_id_sql =
        $placement_interview_id !== null
            ? $placement_interview_id
            : "NULL";
      /* =========================================
       VALIDATION
    ========================================= */
      if (empty($sourceType)) {
          $error = "Missing source type.";
      } elseif ($entity_id <= 0) {
          $error = "Invalid client ID.";
      } elseif ($amount <= 0) {
          $error = "Please enter a valid amount.";
      } elseif (empty($invoice_date)) {
          $error = "Please select invoice date.";
      }
      /* =========================================
       GST CALCULATION
    ========================================= */
      if (empty($error)) {
          if ($gst_type === 'exclusive') {
              $basicAmount = $amount;
              $cgst =
                $basicAmount * 0.09;
              $sgst =
                $basicAmount * 0.09;
              $totalAmount =
                $basicAmount + $cgst + $sgst;
          }
          elseif ($gst_type === 'inclusive') {
              $basicAmount =
                $amount / 1.18;
              $cgst =
                $basicAmount * 0.09;
              $sgst =
                $basicAmount * 0.09;
              $totalAmount =
                $basicAmount + $cgst + $sgst;
          }
          elseif ($gst_type === 'normal') {
              $basicAmount = $amount;
              $cgst = 0;
              $sgst = 0;
              $totalAmount =
                $basicAmount;
          }
          elseif ($gst_type === 'igst') {
              $basicAmount = $amount;
              $cgst = 0;
              $sgst = 0;
              $igst =
                $basicAmount * 0.18;
              $totalAmount =
                $basicAmount + $igst;
          }
          else {
              $error = "Invalid GST type.";
          }
    }
      /* =========================================
       SAME AMOUNT VALIDATION
    ========================================= */
      if (empty($error)) {
          $oldRow =
            $oldRes
                ? mysqli_fetch_assoc($oldRes)
                : null;
          $oldAmount =
            floatval(
                $oldRow['final_amount'] ?? 0
            );
          $lastInvSql = "
            SELECT total_amount
            FROM tbl_gst_invoice
            WHERE entity_id = $entity_id
            AND source_type = '$sourceType'
            ORDER BY id DESC
            LIMIT 1
        ";
          $lastInvRes =
            mysqli_query(
                $conn,
                $lastInvSql
            );
          $lastInvRow =
            $lastInvRes
                ? mysqli_fetch_assoc($lastInvRes)
                : null;
          $lastInvoiceAmount =
            floatval(
                $lastInvRow['total_amount'] ?? 0
            );
          if (
            $lastInvoiceAmount > 0 &&
            abs($oldAmount - $totalAmount) < 0.01
        ) {
              $error =
                "Same amount GST invoice already generated. Change amount to generate new invoice.";
          }
    }
      /* =========================================
       INSERT INVOICE
    ========================================= */
      if (empty($error)) {
          $res = mysqli_query(
            $conn,
            "
            SELECT MAX(invoice_number) AS last_inv
            FROM tbl_gst_invoice
            "
        );
          $row =
            $res
                ? mysqli_fetch_assoc($res)
                : null;
          $lastInvoice =
            intval($row['last_inv'] ?? 0);
          $newInvoiceNumber =
            ($lastInvoice > 0)
                ? $lastInvoice + 1
                : 201;
          /* =====================================
           INSERT
        ===================================== */
          $sql = "
            INSERT INTO tbl_gst_invoice
            (
                entity_id,
                source_type,
                placement_interview_id,
                invoice_number,
                gst_type,
                amount,
                cgst,
                sgst,
                igst,
                total_amount,
                invoice_date,
                comments
            )
            VALUES
            (
                $entity_id,
                '$sourceType',
                $placement_interview_id_sql,
                $newInvoiceNumber,
                '$gst_type',
                $basicAmount,
                $cgst,
                $sgst,
                $igst,
                $totalAmount,
                '$invoice_date',
                '$comments'
            )
        ";
          if (mysqli_query($conn, $sql)) {
              echo "
                <script>
                    window.open(
                        'print-tax-invoice-edit.php?invoice_number=$newInvoiceNumber',
                        '_blank'
                    );
                      window.location.href =
                        'view-gst-client.php';
                </script>
            ";
              exit();
          } else {
              $error =
                "Invoice insert failed: " .
                mysqli_error($conn);
          }
    }
}
