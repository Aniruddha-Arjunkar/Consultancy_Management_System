<script>

/* =========================================================
   ROUND MODAL
========================================================= */

function openRoundDetails(index) {
    const modal = document.getElementById("roundsModal");
    modal.style.display = "flex";
    showRound(index);
}

function closeRounds() {
    const modal = document.getElementById("roundsModal");
    modal.style.display = "none";
}

function showRound(index) {
    const rounds = document.querySelectorAll(".round-detail");
    rounds.forEach(function(round) {
        round.style.display = "none";
    });

    if (rounds[index]) {
        rounds[index].style.display = "block";
    }
}

window.addEventListener("click", function(event) {
    const modal = document.getElementById("roundsModal");
    if (event.target === modal) {
        closeRounds();
    }
});

/* =========================================================
   SCHEDULE DROPDOWN
========================================================= */

function toggleScheduleDropdown(event) {
    event.stopPropagation();
    const wrapper =
        document.querySelector(
            ".schedule-dropdown-wrapper"
        );
    if (!wrapper) {
        return;
    }
    wrapper.classList.toggle("open");
}

/* =========================================================
   CLOSE DROPDOWN OUTSIDE CLICK
========================================================= */
document.addEventListener(
    "click",
    function(event) {
        const wrapper =
            document.querySelector(
                ".schedule-dropdown-wrapper"
            );
        if (!wrapper) {
            return;
        }
        if (!wrapper.contains(event.target)) {
            wrapper.classList.remove("open");
        }
    }
);

/* =========================================================
   SUBMIT INTERVIEW ACTION
========================================================= */

function submitInterviewAction(action) {

    const form =
        document.querySelector(
            ".next-round-page form"
        );

    const actionInput =
        document.getElementById(
            "interviewAction"
        );

    if (!form || !actionInput) {
        return;
    }

    /* -----------------------------------------
       COMPLETE CONFIRMATION
    ----------------------------------------- */

    if (action === "complete") {

        const confirmComplete = confirm(
            "Are you sure you want to mark this interview as Completed?"
        );

        if (!confirmComplete) {
            return;
        }

    }

    /* -----------------------------------------
       RESCHEDULE CONFIRMATION
    ----------------------------------------- */

    if (action === "reschedule") {

        const confirmReschedule = confirm(
            "Are you sure you want to Reschedule this interview?"
        );

        if (!confirmReschedule) {
            return;
        }

    }
    /* -----------------------------------------
       NEXT ROUND CONFIRMATION
    ----------------------------------------- */
    if (action === "schedule_next") {

        const confirmNextRound = confirm(
            "Schedule the next interview round?"
        );
        if (!confirmNextRound) {
            return;
        }
    }
    /* -----------------------------------------
       Set Action
    ----------------------------------------- */
    actionInput.value = action;
    /* -----------------------------------------
       Submit
    ----------------------------------------- */
    form.submit();
}
</script>
<script src="js/bootstrap.js"></script>
<script src="js/jquery.dcjqaccordion.2.7.js"></script>
<script src="js/scripts.js"></script>
<script src="js/jquery.slimscroll.js"></script>
<script src="js/jquery.nicescroll.js"></script>
<script src="js/jquery.scrollTo.js"></script>
</body>
</html>
