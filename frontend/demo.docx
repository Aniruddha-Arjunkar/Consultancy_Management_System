<script>

document.getElementById('payment_type').addEventListener('change', function () {

    var val = this.value;

    document.getElementById('company_pay_fields').style.display =
        (val === 'Company Pay' || val === 'Both Pay')
            ? 'block'
            : 'none';

    document.getElementById('candidate_pay_fields').style.display =
        (val === 'Candidate Pay' || val === 'Both Pay')
            ? 'block'
            : 'none';
});

function calculateGST(base) {
    const gst = base * 0.18;
    const total = base + gst;
    return {
        gst: gst.toFixed(2),
        total: total.toFixed(2)
    };
}


function updateCompanyGST() {
    const base = parseFloat(document.getElementById('company_pay_amount').value || 0);

    if (document.getElementById('company_gst_applicable').checked &&
        base > 0) {
        const result = calculateGST(base);
        document.getElementById('company_gst_value').innerText =
            result.gst;
        document.getElementById('company_total_value').innerText =
            result.total;
        document.getElementById('company_gst_details').style.display =
            'block';
    } else {
        document.getElementById('company_gst_details').style.display =
            'none';
    }
}

function updateCandidateGST() {

    const base = parseFloat(document.getElementById('candidate_pay_amount').value || 0);

    if (document.getElementById('candidate_gst_applicable').checked &&
        base > 0) {
        const result = calculateGST(base);
        document.getElementById('candidate_gst_value').innerText =
            result.gst;
        document.getElementById('candidate_total_value').innerText =
            result.total;

        document.getElementById('candidate_gst_details').style.display =
          'block';
    } else {
        document.getElementById('candidate_gst_details').style.display =
            'none';

    }

}

document.getElementById('company_gst_applicable')
    .addEventListener('change', updateCompanyGST);
document.getElementById('company_pay_amount')
    .addEventListener('input', updateCompanyGST);
document.getElementById('candidate_gst_applicable')
    .addEventListener('change', updateCandidateGST);
document.getElementById('candidate_pay_amount')
    .addEventListener('input', updateCandidateGST);
</script>
