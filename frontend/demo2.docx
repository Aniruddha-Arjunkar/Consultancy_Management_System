        </div>
    </section>
</section>
<!-- =========================================================
     DEFAULTER MODAL
========================================================= -->
<div
    class="modal fade"
    id="defaulterModal"
    tabindex="-1"
    role="dialog"
    aria-labelledby="defaulterModalLabel"
>
    <div
        class="modal-dialog"
        role="document"
    >

        <form
            method="POST"
            action="mark-defaulter.php"
        >

            <div class="modal-content">


                <div class="modal-header">

                    <h4
                        class="modal-title"
                        id="defaulterModalLabel"
                    >
                        Mark Client as Defaulter
                    </h4>


                    <button
                        type="button"
                        class="close"
                        data-dismiss="modal"
                        aria-label="Close"
                    >

                        &times;

                    </button>

                </div>


                <div class="modal-body">


                    <input
                        type="hidden"
                        name="client_Id"
                        id="modal-client-id"
                    >


                    <div class="form-group">

                        <label>
                            Client Name:
                        </label>

                        <input
                            type="text"
                            class="form-control"
                            id="modal-client-name"
                            readonly
                        >

                    </div>


                    <div class="form-group">

                        <label
                            for="defaulter_note"
                        >
                            Reason:
                        </label>

                        <textarea
                            class="form-control"
                            name="defaulter_note"
                            id="defaulter_note"
                            rows="4"
                            required
                        ></textarea>

                    </div>


                </div>


                <div class="modal-footer">

                    <button
                        type="submit"
                        class="btn btn-danger"
                    >
                        Submit
                    </button>


                    <button
                        type="button"
                        class="btn btn-secondary"
                        data-dismiss="modal"
                    >
                        Cancel
                    </button>

                </div>


            </div>

        </form>

    </div>

</div>


<style>

    
    /* =========================================================
   DEFAULTER MODAL - MODERN DESIGN
========================================================= */

#defaulterModal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 99999;

    background: rgba(15, 23, 42, 0.62);
    backdrop-filter: blur(4px);

    overflow-y: auto;
    padding: 20px;
    box-sizing: border-box;
}

#defaulterModal.show {
    display: flex;
    align-items: center;
    justify-content: center;
}

/* MODAL BOX */
#defaulterModal .modal-dialog {
    width: 100%;
    max-width: 500px;
    margin: 0 auto;
    animation: defaulterModalIn 0.25s ease;
}

@keyframes defaulterModalIn {
    from {
        opacity: 0;
        transform: translateY(-20px) scale(0.97);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}

#defaulterModal .modal-content {
    position: relative;

    background: #ffffff;

    border: none;
    border-radius: 16px;

    overflow: hidden;

    box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.25),
        0 8px 25px rgba(0, 0, 0, 0.12);
}


/* =========================================================
   MODAL HEADER
========================================================= */

#defaulterModal .modal-header {
    position: relative;

    display: flex;
    align-items: center;

    padding: 20px 24px;

    background: linear-gradient(
        135deg,
        #fff5f5,
        #ffffff
    );

    border-bottom: 1px solid #f1f1f1;
}

#defaulterModal .modal-title {
    margin: 0;

    padding-right: 35px;

    font-size: 21px;
    font-weight: 700;

    color: #1f2937;

    line-height: 1.3;
}

/* RED ICON BEFORE TITLE */
#defaulterModal .modal-title::before {
    content: "⚠";

    display: inline-flex;
    align-items: center;
    justify-content: center;

    width: 38px;
    height: 38px;

    margin-right: 11px;

    border-radius: 10px;

    background: #fee2e2;
    color: #dc2626;

    font-size: 19px;

    vertical-align: middle;
}


/* =========================================================
   CLOSE BUTTON
========================================================= */

#defaulterModal .close {
    position: absolute;

    top: 17px;
    right: 18px;

    width: 34px;
    height: 34px;

    padding: 0;

    border: none;
    border-radius: 50%;

    background: #f3f4f6;

    color: #6b7280;

    font-size: 22px;
    line-height: 32px;

    opacity: 1;

    cursor: pointer;

    transition: all 0.2s ease;
}

#defaulterModal .close:hover {
    background: #fee2e2;
    color: #dc2626;

    transform: rotate(90deg);
}


/* =========================================================
   MODAL BODY
========================================================= */

#defaulterModal .modal-body {
    padding: 24px;
}


/* FORM GROUP */
#defaulterModal .form-group {
    margin-bottom: 20px;
}

#defaulterModal .form-group:last-child {
    margin-bottom: 0;
}


/* LABEL */
#defaulterModal label {
    display: block;

    margin-bottom: 8px;

    font-size: 14px;
    font-weight: 600;

    color: #374151;
}


/* INPUT + TEXTAREA */
#defaulterModal .form-control {
    width: 100%;

    box-sizing: border-box;

    padding: 12px 14px;

    border: 1px solid #d1d5db;
    border-radius: 9px;

    background: #ffffff;

    color: #1f2937;

    font-size: 14px;

    outline: none;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease,
        background 0.2s ease;
}

#defaulterModal .form-control:focus {
    border-color: #ef4444;

    box-shadow:
        0 0 0 3px rgba(239, 68, 68, 0.12);
}


/* CLIENT NAME READONLY */
#defaulterModal #modal-client-name {
    background: #f8fafc;
    color: #4b5563;
    font-weight: 600;
}


/* TEXTAREA */
#defaulterModal textarea.form-control {
    min-height: 110px;

    resize: vertical;

    line-height: 1.5;
}


/* =========================================================
   MODAL FOOTER
========================================================= */

#defaulterModal .modal-footer {
    display: flex;
    justify-content: flex-end;
    align-items: center;

    gap: 10px;

    padding: 17px 24px;

    background: #fafafa;

    border-top: 1px solid #eeeeee;
}


/* =========================================================
   SUBMIT BUTTON
========================================================= */

#defaulterModal .btn-danger {
    min-width: 125px;

    padding: 10px 18px;

    border: none;
    border-radius: 8px;

    background: #dc2626;
    color: #ffffff;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    box-shadow:
        0 4px 10px rgba(220, 38, 38, 0.20);

    transition: all 0.2s ease;
}

#defaulterModal .btn-danger:hover {
    background: #b91c1c;

    transform: translateY(-1px);

    box-shadow:
        0 6px 14px rgba(220, 38, 38, 0.25);
}


/* =========================================================
   CANCEL BUTTON
========================================================= */

#defaulterModal .btn-secondary {
    min-width: 90px;

    padding: 10px 18px;

    border: 1px solid #d1d5db;
    border-radius: 8px;

    background: #ffffff;
    color: #4b5563;

    font-size: 14px;
    font-weight: 600;

    cursor: pointer;

    transition: all 0.2s ease;
}

#defaulterModal .btn-secondary:hover {
    background: #f3f4f6;
    border-color: #9ca3af;
}


/* =========================================================
   MOBILE
========================================================= */

@media (max-width: 600px) {

    #defaulterModal {
        padding: 15px;
    }

    #defaulterModal .modal-dialog {
        max-width: 100%;
    }

    #defaulterModal .modal-header {
        padding: 17px 18px;
    }

    #defaulterModal .modal-title {
        font-size: 18px;
    }

    #defaulterModal .modal-title::before {
        width: 34px;
        height: 34px;

        font-size: 17px;
    }

    #defaulterModal .modal-body {
