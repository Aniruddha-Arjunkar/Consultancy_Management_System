the seniors code first and we will implement it view-associate-details.php -----------> "
<?php
session_start();
if (!isset($_SESSION['email'])) {
    $_SESSION['msg'] = "You must log in first";
    header('location: login.php');
    exit();
}
if (isset($_GET['logout'])) {
    session_destroy();
    unset($_SESSION['email']);
    header('location: login.php');
    exit();
}

require_once 'db_connect.php';
include 'header.php';

$max_rows_to_show = 5; // Show 5 rows by default

// Validate and sanitize the ID parameter from the URL
if (isset($_GET['id'])) {
    $id = mysqli_real_escape_string($conn, $_GET['id']);

    // Fetch associate details from the database
    $sql = "SELECT * FROM tbl_associate WHERE Id = $id";
    $result = mysqli_query($conn, $sql);

    if (mysqli_num_rows($result) > 0) {
        $row = mysqli_fetch_assoc($result);
        // Associate details
        $company_name = $row['company_name'];
        $location = $row['location'];
        $shipping_address = $row['shipping_address'];
        $gst_number = $row['gst_number'];
        $working_domain = $row['working_domain'];
        $working_technology = $row['working_technology'];
        $no_of_employee = $row['no_of_employee'];
        $contact_person = $row['contact_person'];
        $phone = $row['phone'];
        $email = $row['email'];
        $manager_name  = $row['manager_name'] ?? '';
        $manager_phone = $row['manager_phone'] ?? '';
        $manager_email = $row['manager_email'] ?? '';
        $pay_package_fresher = $row['pay_package_fresher'];
        $pay_package_experienced = $row['pay_package_experienced'];
        $sla_agreed = $row['sla_agreed'];
        $pay_for_fresher = $row['pay_for_fresher'];
        $pay_for_experienced = $row['pay_for_experienced'];

        // Fetch candidates from the tbl_placement table, join with tbl_agreement to get candidate name
        $placement_sql = "
    SELECT 
        p.*,
        a.name AS candidate_name,
        -- Total paid from installments
    SUM(
        CASE 
            WHEN pay.payment_type = 'Company Pay'
            THEN pay.paid_amount 
            ELSE 0 
        END
    ) AS total_paid,
    MAX(
    CASE 
        WHEN pay.payment_type = 'Company Pay'
        THEN pay.tds_amount 
        ELSE 0 
    END
) AS total_tds,

    -- Total invoice amount (only once)
    MAX(
        CASE 
             WHEN pay.payment_type = 'Company Pay' 
            THEN pay.total_amount 
            ELSE 0 
        END
    ) AS invoice_total,

    MAX(pay.status) AS payment_status,
   GROUP_CONCAT(
    CASE 
        WHEN pay.payment_type = 'Company Pay'
        THEN CONCAT(
            IFNULL(pay.paid_amount, 0),
            ' (Due: ',
            IFNULL(pay.due_date, 'N/A'),
            ')'
        )
    END
    SEPARATOR '<br>'
) AS payments_detail
,

        gi.cgst,
    gi.sgst,
    gi.igst,
    gi.total_amount AS gst_total_amount
    
    FROM tbl_placement p
    JOIN tbl_agreement a ON p.candidate_id = a.id
    LEFT JOIN tbl_payment pay ON pay.client_Id = p.candidate_id
    AND pay.interview_id = p.interview_id
    
    LEFT JOIN tbl_gst_invoice gi 
    ON gi.placement_interview_id = p.interview_id
    AND gi.source_type = 'Consultant'
    
    WHERE p.company_name = '$company_name'
    GROUP BY p.candidate_id, a.name, p.company_pay_amount, p.company_gst_amount, p.company_pay_date, p.pay_remark, p.interview_id
";




        $placement_result = mysqli_query($conn, $placement_sql);

        // Separate candidates based on interview status
        $placed_candidates = [];
        $scheduled_candidates = [];
        $completed_candidates = [];
        $rejected_candidates = [];

        while ($candidate = mysqli_fetch_assoc($placement_result)) {
            if ($candidate['interview_status'] === 'Placed') {
                $placed_candidates[] = $candidate;
            } elseif ($candidate['interview_status'] === 'Scheduled') {
                $scheduled_candidates[] = $candidate;
            } elseif ($candidate['interview_status'] === 'Completed') {
              $completed_candidates[] = $candidate;         
            } elseif ($candidate['interview_status'] === 'Rejected') {
                $rejected_candidates[] = $candidate;
            }
        }
        
    } else {
        echo "No associate found with the given ID.";
        exit();
    }
} else {
    echo "ID parameter is missing.";
    exit();
}


// Prepare Payment categories
$paid_candidates = $partial_candidates = $unpaid_candidates = $defaulted_candidates = [];

foreach ($placed_candidates as $candidate) {
    $total_paid   = (float)($candidate['total_paid'] ?? 0);
    $invoice_total = (float)($candidate['invoice_total'] ?? 0);
    $status = strtolower($candidate['payment_status'] ?? '');

    if ($status === 'defaulted') {
        $defaulted_candidates[] = $candidate;
    } elseif ($total_paid >= $invoice_total && $invoice_total > 0) {
        $paid_candidates[] = $candidate;
    } elseif ($total_paid > 0 && $total_paid < $invoice_total) {
        $partial_candidates[] = $candidate;
    } else {
        $unpaid_candidates[] = $candidate;
    }
}

// Function to render Payment table
function renderPaymentTable($candidates, $max_rows_to_show) {
    if (count($candidates) === 0) {
        echo "<tr><td colspan='8'>No candidates in this category.</td></tr>";
        return;
    }
    
     // ðŸ”¹ Check if any candidate has TDS
    $show_tds_column = false;
    foreach ($candidates as $c) {
        if (!empty($c['total_tds']) && $c['total_tds'] > 0) {
            $show_tds_column = true;
            break;
        }
    }

    foreach ($candidates as $index => $candidate) {
        $base = (float)($candidate['company_pay_amount'] ?? 0);
        $company_gst = (float)($candidate['company_gst_amount'] ?? 0);
        $total = $base + $company_gst;
        
        $total_paid   = (float)($candidate['total_paid'] ?? 0);
        $invoice_total = (float)($candidate['invoice_total'] ?? 0);
         $total_tds = (float)($candidate['total_tds'] ?? 0);
       // âœ… Balance calculation including TDS
        $balance_amount = max($invoice_total - $total_paid - $total_tds, 0);
        
        $payments = $candidate['payments_detail'] ?? '-';
        $paid_amounts = ['-'];
        $due_dates = ['-'];
        if (!empty($payments) && $payments !== '-') {
            $parts = explode('<br>', $payments);
            $paid_amounts = [];
            $due_dates = [];
            foreach ($parts as $p) {
                if (preg_match('/([\d\.]+)\s*\(Due:\s*([^)]+)\)/', trim($p), $matches)) {
                    $paid_amounts[] = $matches[1];
                    $due_dates[] = $matches[2];
                }
            }
        }
        if (empty($paid_amounts)) $paid_amounts = ['-'];
        if (empty($due_dates)) $due_dates = ['-'];
        
        
        $rows = max(count($paid_amounts), 1);

        $row_class = ($index >= $max_rows_to_show) ? 'extra-row' : '';

        for ($i = 0; $i < $rows; $i++):
?>
<tr class="<?= $row_class ?>">
    <?php if ($i === 0): ?>
    <td><?= htmlspecialchars($candidate['candidate_name']); ?></td>
    <td><?= number_format($base,2); ?></td>
    <td><?= $company_gst > 0 ? number_format($company_gst,2) : '-'; ?></td>
    <td><strong><?= number_format($total,2); ?></strong></td>
     <?php endif; ?>
    <td><?= number_format((float)$paid_amounts[$i],2); ?></td>
    


<?php if ($show_tds_column && $i === 0): ?>
    <td rowspan="<?= $rows ?>">
        <?= number_format($total_tds,2); ?>
    </td>
<?php endif; ?>
    
    <td><?= number_format($balance_amount,2); ?></td>
    <td><?= htmlspecialchars($due_dates[$i]); ?></td>

    <?php if ($i === 0): ?>
    <td rowspan="<?= $rows ?>">
        <?php
        
        $status = strtolower($candidate['payment_status'] ?? '');
        if ($status === 'defaulted') echo "<span class='badge badge-danger'>Defaulted</span>";
        elseif ($total_paid >= $invoice_total && $invoice_total > 0) echo "<span class='btn btn-success'>Paid</span>";
        elseif ($total_paid > 0 && $total_paid < $invoice_total) echo "<span class='btn btn-info'>Partially Paid</span>";
        else echo "<span class='btn btn-warning'>Unpaid</span>";
        ?>
    </td>
    <?php endif; ?>
</tr>
<?php
        endfor;
    }

    // Show "See More" if more rows
    if (count($candidates) > $max_rows_to_show) {
        echo "<tr class='see-more-row'><td colspan='8' style='text-align:center;'>
              <button class='btn btn-primary btn-sm' onclick='showMoreRows(this)'>See More</button>
              </td></tr>";
    }
}

// Function to render simple candidate tables (Scheduled / Placed / Rejected)
function renderCandidateTable($candidates, $columns, $max_rows_to_show) {
    if (count($candidates) === 0) {
        echo "<tr><td colspan='".count($columns)."'>No records found.</td></tr>";
        return;
    }

    foreach ($candidates as $index => $candidate) {
        $row_class = ($index >= $max_rows_to_show) ? 'extra-row' : '';
        echo "<tr class='{$row_class}'>";
        foreach ($columns as $col) {
            echo "<td>".htmlspecialchars($candidate[$col] ?? '-')."</td>";
        }
        echo "</tr>";
    }

    if (count($candidates) > $max_rows_to_show) {
        echo "<tr class='see-more-row'><td colspan='".count($columns)."' style='text-align:center;'>
              <button class='btn btn-primary btn-sm' onclick='showMoreRows(this)'>See More</button>
              </td></tr>";
    }
}
