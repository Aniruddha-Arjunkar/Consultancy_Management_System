                        $sql = "SELECT Id, cust_name, designation
                                FROM tbl_employee
                                WHERE cust_name LIKE '%$key%'";

                        $result = mysqli_query($conn, $sql);


                        if ($result && mysqli_num_rows($result) > 0) {

                    ?>

