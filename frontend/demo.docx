  <!-- =========================================
     GST CALCULATION JAVASCRIPT
========================================= -->
  <script>
const amountInput =
    document.getElementById('amount');
const gstTypeSelect =
    document.getElementById('gst_type');
const totalVal =
    document.getElementById('total_val');
const baseVal =
    document.getElementById('base_val');
const cgstVal =
    document.getElementById('cgst_val');
const sgstVal =
    document.getElementById('sgst_val');
const igstVal =
    document.getElementById('igst_val');
const cgstRow =
    document.getElementById('cgst_row');
const sgstRow =
    document.getElementById('sgst_row');
const igstRow =
    document.getElementById('igst_row');
  /* =========================================
   CALCULATE GST
========================================= */
  function calculateTotal() {
    const amount =
        parseFloat(amountInput.value) || 0;
    const gstType =
        gstTypeSelect.value;
    let base = amount;
    let cgst = 0;
    let sgst = 0;
    let igst = 0;
    let total = 0;
    /* Hide GST rows */
    cgstRow.style.display = 'none';
    sgstRow.style.display = 'none';
    igstRow.style.display = 'none';
      /* =====================================
       EXCLUSIVE GST
    ===================================== */
      if (gstType === 'exclusive') {
        base = amount;
        cgst =
            base * 0.09;
        sgst =
            base * 0.09;
        total =
            base + cgst + sgst;
        cgstRow.style.display =
            'block';
        sgstRow.style.display =
            'block';
                    }
      /* ===================================
       INCLUSIVE GST
    ===================================== */
      else if (gstType === 'inclusive') {
        base =
            amount / 1.18;
        cgst =
            base * 0.09;
        sgst =
            base * 0.09;
        total =
            amount;
        cgstRow.style.display =
            'block';
        sgstRow.style.display =
            'block';
    }
      /* =====================================
       NORMAL
    ===================================== */
      else if (gstType === 'normal') {
        base =
            amount;
        total =
            base;
    }
      /* =====================================
       IGST
    ===================================== */
    else if (gstType === 'igst') {
        base =
            amount;
        igst =
            base * 0.18;
        total =
            base + igst;
        igstRow.style.display =
            'block';
    }
    /* =====================================
       DISPLAY VALUES
    ===================================== */
    totalVal.textContent =
        total.toFixed(2);
    baseVal.textContent =
        base.toFixed(2);
    cgstVal.textContent =
        cgst.toFixed(2);
    sgstVal.textContent =
        sgst.toFixed(2);
    igstVal.textContent =
        igst.toFixed(2);
}
/* =========================================
   AMOUNT CHANGE
========================================= */
amountInput.addEventListener(
    'input',
    calculateTotal
);
/* =========================================
   GST TYPE CHANGE
========================================= */
gstTypeSelect.addEventListener(
    'change',
    calculateTotal
);
/* =========================================
   PAGE LOAD
========================================= */
window.addEventListener(
    'load',
    function () {
        if (!gstTypeSelect.value) {
            gstTypeSelect.value =
                'exclusive';
        }
        calculateTotal();
    }
);
</script>
