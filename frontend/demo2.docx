now lets implement InterviewScheduled.jsx > Action Column > update button (we have UpdateInterviewSchedule.jsx which is placeholder) . Here we Update the 
interview Status ('Scheduled','Rescheduled','Placed','Rejected','Completed') , Data - time , Remarks and other information regarding interview and keep some imformation
Candidate name  , Company name , Job profile remain same for that individual candidate . we have to implement every single functionality preserving seniors UI and
 Same classNames . Don't make any changes by youself , first analyze seniors code and  give me code file .Seniors code file update-interview.php ----> "<?php
session_start();

if (!isset($_SESSION['email'])) {
    $_SESSION['msg'] = "You must log in first";
    header('location:login.php');
    exit();
}

require_once 'db_connect.php';

if (!isset($_GET['id'])) {
    die("Invalid interview ID.");
}

$interview_id = (int)$_GET['id'];


/*
|--------------------------------------------------------------------------
| Fetch Current Interview
|--------------------------------------------------------------------------
*/

$sql = "
    SELECT p.*, a.name AS candidate_name
    FROM tbl_placement p
    LEFT JOIN tbl_agreement a
        ON p.candidate_id = a.Id
    WHERE p.interview_id = ?
";

$stmt = $conn->prepare($sql);

if (!$stmt) {
    die("Prepare failed: " . $conn->error);
}

$stmt->bind_param("i", $interview_id);
$stmt->execute();

$result = $stmt->get_result();

$current = $result->fetch_assoc();

$stmt->close();

if (!$current) {
    die("Interview not found.");
}


/*
|--------------------------------------------------------------------------
| Current Round + Status
|--------------------------------------------------------------------------
*/

$current_round = (int)($current['interview_round'] ?? 1);

if ($current_round < 1) {
    $current_round = 1;
}

$current_status = trim(
    $current['interview_status'] ?? 'Scheduled'
);

$next_round = $current_round + 1;


/*
|--------------------------------------------------------------------------
| Handle POST Actions
|--------------------------------------------------------------------------
*/

if ($_SERVER['REQUEST_METHOD'] === 'POST') {

    $action = $_POST['action'] ?? '';


    /*
    |--------------------------------------------------------------------------
    | RESCHEDULE SAME ROUND
    |--------------------------------------------------------------------------
    */

    if ($action === 'reschedule') {

        $interview_date = trim(
            $_POST['interview_date'] ?? ''
        );

        $interview_time = trim(
            $_POST['interview_time'] ?? ''
        );

        $hr_name = trim(
            $_POST['hr_name'] ?? ''
        );

        $remark = trim(
            $_POST['remark'] ?? ''
        );


        if (
            $interview_date === '' ||
            $interview_time === '' ||
            $hr_name === ''
        ) {

            echo "
            <script>
                alert('Please enter Interview Date, Time and HR Name.');
                window.history.back();
            </script>
            ";

            exit();
        }


        $conn->begin_transaction();

        try {

            $update_sql = "
                UPDATE tbl_placement
                SET
                    interview_date = ?,
                    interview_time = ?,
                    hr_name = ?,
                    remark = ?,
                    interview_status = 'Rescheduled'
                WHERE interview_id = ?
            ";

            $update_stmt = $conn->prepare($update_sql);

            if (!$update_stmt) {
                throw new Exception(
                    "Reschedule prepare failed: " .
                    $conn->error
                );
            }

            $update_stmt->bind_param(
                "ssssi",
                $interview_date,
                $interview_time,
                $hr_name,
                $remark,
                $interview_id
            );

            if (!$update_stmt->execute()) {
                throw new Exception(
                    "Reschedule failed: " .
                    $update_stmt->error
                );
            }

            $update_stmt->close();

            $conn->commit();


            echo "
            <script>
                alert(
                    'Round {$current_round} rescheduled successfully.'
                );

                window.location.href =
                    'view-interview-schedule-student.php';
            </script>
            ";

            exit();

        } catch (Exception $e) {

            $conn->rollback();

            die(
                "Error: " .
                htmlspecialchars($e->getMessage())
            );
        }
    }


    /*
    |--------------------------------------------------------------------------
    | COMPLETE SAME ROUND
    |--------------------------------------------------------------------------
    */

    if ($action === 'complete') {

        $conn->begin_transaction();

        try {

            $complete_sql = "
                UPDATE tbl_placement
                SET interview_status = 'Completed'
                WHERE interview_id = ?
            ";

            $complete_stmt = $conn->prepare(
                $complete_sql
            );

            if (!$complete_stmt) {
                throw new Exception(
                    "Complete prepare failed: " .
                    $conn->error
                );
            }

            $complete_stmt->bind_param(
                "i",
                $interview_id
            );

            if (!$complete_stmt->execute()) {
                throw new Exception(
                    "Complete failed: " .
                    $complete_stmt->error
                );
            }

            $complete_stmt->close();

            $conn->commit();


            echo "
            <script>

                alert(
                    'Round {$current_round} marked as Completed.'
                );

                window.location.href =
                    'view-interview-schedule-student.php';

            </script>
            ";

            exit();

        } catch (Exception $e) {

            $conn->rollback();

            die(
                "Error: " .
                htmlspecialchars($e->getMessage())
            );
        }
    }


    /*
    |--------------------------------------------------------------------------
    | SCHEDULE NEXT ROUND
    |--------------------------------------------------------------------------
    */

    if ($action === 'schedule_next') {

        /*
        |--------------------------------------------------------------
        | IMPORTANT:
        | Calculate next round from database/current row.
        | Never trust posted round.
        |--------------------------------------------------------------
        */

        $new_round = $current_round + 1;


        /*
        |--------------------------------------------------------------
        | Current round MUST be completed first
        |--------------------------------------------------------------
        */

        if ($current_status !== 'Completed') {

            echo "
            <script>

                alert(
                    'Round {$current_round} is still in process. Please Reschedule or Complete it first.'
                );

                window.location.href =
                    'view-interview-schedule-student.php';

            </script>
            ";

            exit();
        }


        $position = trim(
            $_POST['position'] ?? ''
        );

        $interview_date = trim(
            $_POST['interview_date'] ?? ''
        );

        $interview_time = trim(
            $_POST['interview_time'] ?? ''
        );

        $hr_name = trim(
            $_POST['hr_name'] ?? ''
        );

        $remark = trim(
            $_POST['remark'] ?? ''
        );


        if (
            $position === '' ||
            $interview_date === '' ||
            $interview_time === '' ||
            $hr_name === ''
        ) {

            echo "
            <script>

                alert(
                    'Please fill Position, Date, Time and HR Name.'
                );

                window.history.back();

            </script>
            ";

            exit();
        }


        $conn->begin_transaction();

        try {

            /*
            |--------------------------------------------------------------------------
            | Insert NEW Round
            |--------------------------------------------------------------------------
            */

            $insert_sql = "
                INSERT INTO tbl_placement
                (
                    candidate_id,
                    company_name,
                    position,
                    interview_date,
                    interview_time,
                    hr_name,
                    remark,
                    interview_status,
                    interview_round
                )
                VALUES
                (
                    ?, ?, ?, ?, ?, ?, ?, 'Scheduled', ?
                )
            ";

            $insert_stmt = $conn->prepare(
                $insert_sql
            );

            if (!$insert_stmt) {
                throw new Exception(
                    "Next round prepare failed: " .
                    $conn->error
                );
            }


            $insert_stmt->bind_param(
                "issssssi",
                $current['candidate_id'],
                $current['company_name'],
                $position,
                $interview_date,
                $interview_time,
                $hr_name,
                $remark,
                $new_round
            );


            if (!$insert_stmt->execute()) {

                throw new Exception(
                    "Next round insert failed: " .
                    $insert_stmt->error
                );
            }

            $insert_stmt->close();


            $conn->commit();


            echo "
            <script>

                alert(
                    'Round {$new_round} scheduled successfully.'
                );

                window.location.href =
                    'view-interview-schedule-student.php';

            </script>
            ";

            exit();


        } catch (Exception $e) {

            $conn->rollback();

            die(
                "Error: " .
                htmlspecialchars($e->getMessage())
            );
        }
    }
}


/*
|--------------------------------------------------------------------------
| Fetch ALL Interview Rounds
|--------------------------------------------------------------------------
*/

$all_rounds = [];

$round_sql = "
    SELECT p.*, a.name AS candidate_name
    FROM tbl_placement p
    LEFT JOIN tbl_agreement a
        ON p.candidate_id = a.Id
    WHERE p.candidate_id = ?
      AND p.company_name = ?
    ORDER BY
        p.interview_round ASC,
        p.interview_id ASC
";

$round_stmt = $conn->prepare($round_sql);

if (!$round_stmt) {
    die(
        "Round prepare failed: " .
        $conn->error
    );
}

$round_stmt->bind_param(
    "is",
    $current['candidate_id'],
    $current['company_name']
);

$round_stmt->execute();

$round_result = $round_stmt->get_result();

while ($row = $round_result->fetch_assoc()) {
    $all_rounds[] = $row;
}

$round_stmt->close();


include 'header.php';
?>


