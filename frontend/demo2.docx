    }

    #defaulterModal .modal-footer {
        padding: 15px 18px;
    }

}

</style>

<!-- =========================================================
     EXISTING JS
========================================================= -->

<script src="js/bootstrap.js"></script>
<script src="js/jquery.dcjqaccordion.2.7.js"></script>
<script src="js/scripts.js"></script>
<script src="js/jquery.slimscroll.js"></script>
<script src="js/jquery.nicescroll.js"></script>
<script src="js/jquery.scrollTo.js"></script>


<script>

/* =========================================================
   RECORD COUNT
========================================================= */

function calculateRecordCount() {

    let count = 0;

    document
        .querySelectorAll(
            '#payments-table tbody tr'
        )
        .forEach(function(row) {

            if (
                row.style.display !== 'none'
                &&
                !row.querySelector(
                    '.view-client-no-data'
                )
            ) {

                count++;

            }

        });


    document.getElementById(
        'record-count'
    ).textContent = count;

}


/* =========================================================
   TOTAL DUE
========================================================= */

function calculateTotalDue() {

    let totalDue = 0;


    document
        .querySelectorAll(
            '#payments-table tbody tr'
        )
        .forEach(function(row) {


            if (
                row.style.display !== 'none'
                &&
                !row.querySelector(
                    '.view-client-no-data'
                )
            ) {


                const dueCell =
                    row.querySelector(
                        '.view-client-due-amount'
                    );


                if (!dueCell) {
                    return;
                }


                const dueAmount =
                    parseFloat(
                        dueCell.textContent
                            .replace(/,/g, '')
                            .replace(/₹/g, '')
                            .trim()
                    ) || 0;


                totalDue += dueAmount;

            }

        });


    document.getElementById(
        'total-due'
    ).textContent =
        totalDue.toFixed(2);

}


/* =========================================================
   SEARCH
========================================================= */

function searchPayments() {
    const input = document.getElementById("txt_searchall");
    const query = input.value.toLowerCase().trim();

    const rows = document.querySelectorAll("tbody tr");

    rows.forEach(row => {

        const name = row.querySelector(".view-client-name")?.textContent.toLowerCase() || "";
        const branch = row.querySelector(".view-client-branch")?.textContent.toLowerCase() || "";
        const phone = row.querySelector(".view-client-phone")?.textContent.toLowerCase() || "";
        const service = row.querySelector(".view-client-service")?.textContent.toLowerCase() || "";

        // Due Date
        const dueDateElement = row.querySelector(".due-date");

        const dueDate = dueDateElement?.textContent.toLowerCase().trim() || "";
        const dueDateData = dueDateElement?.getAttribute("data-due-date")?.toLowerCase() || "";

        const match =
            name.includes(query) ||
            branch.includes(query) ||
            phone.includes(query) ||
            service.includes(query) ||
            dueDate.includes(query) ||
            dueDateData.includes(query);

        row.style.display = match ? "" : "none";
    });

    calculateTotalDue();
    calculateRecordCount();
}

/* =========================================================
   SEARCH EVENT
========================================================= */

const searchInput =
    document.getElementById(
        'txt_searchall'
    );


if (searchInput) {

    searchInput.addEventListener(
        'input',
        searchPayments
    );

}


/* =========================================================
   ACTION BUTTON TOGGLE
========================================================= */

document.querySelectorAll('.toggle-action-btn').forEach(function (btn) {

    btn.addEventListener('click', function (e) {

        e.preventDefault();
        e.stopPropagation();

        const actionDiv =
            this.parentElement.querySelector(
                '.view-client-action-buttons'
            );

        const isOpen =
            actionDiv.classList.contains('show');

        /* Close all other action menus */
        document.querySelectorAll(
            '.view-client-action-buttons'
        ).forEach(function (menu) {

            menu.classList.remove('show');

        });

        document.querySelectorAll(
            '.toggle-action-btn'
        ).forEach(function (button) {

            button.classList.remove('active');

        });


        /* Open clicked menu */
        if (!isOpen) {

            actionDiv.classList.add('show');

            this.classList.add('active');

        }

    });

});


/* =========================================================
   CLOSE ACTION MENU WHEN CLICK OUTSIDE
========================================================= */

document.addEventListener('click', function (e) {

    if (
        !e.target.closest('.view-client-action')
    ) {

        document.querySelectorAll(
            '.view-client-action-buttons'
        ).forEach(function (menu) {

            menu.classList.remove('show');

        });

        document.querySelectorAll(
            '.toggle-action-btn'
        ).forEach(function (button) {

            button.classList.remove('active');

        });

    }

});

/* =========================================================
   DEFAULTER MODAL
========================================================= */
/* =========================================================
   DEFAULTER MODAL
========================================================= */

document
    .querySelectorAll('.open-defaulter-modal')
    .forEach(function(button) {

        button.addEventListener('click', function(e) {

            e.preventDefault();
            e.stopPropagation();

            const clientId =
                this.getAttribute('data-clientid');

            const name =
                this.getAttribute('data-name');

            document.getElementById(
                'modal-client-id'
            ).value = clientId;

            document.getElementById(
                'modal-client-name'
            ).value = name;

            document.getElementById(
                'defaulterModal'
            ).classList.add('show');

        });

    });


/* =========================================================
   CLOSE DEFAULTER MODAL
========================================================= */

document
    .querySelectorAll(
        '#defaulterModal [data-dismiss="modal"]'
    )
    .forEach(function(button) {

        button.addEventListener('click', function() {

            document.getElementById(
                'defaulterModal'
            ).classList.remove('show');

        });

    });


/* =========================================================
   CLOSE MODAL WHEN CLICKING OUTSIDE
========================================================= */

document
    .getElementById('defaulterModal')
    .addEventListener('click', function(e) {

        if (e.target === this) {

            this.classList.remove('show');

        }

    });


/* =========================================================
   DUE DATE HIGHLIGHT
========================================================= */

function highlightDueDates() {


    const now =
        new Date();


    const today =
        new Date(
            now.getFullYear(),
            now.getMonth(),
            now.getDate()
        );


    document
        .querySelectorAll(
            '.due-date'
        )
        .forEach(function(span) {


            const dueDateValue =
                span.getAttribute(
                    'data-due-date'
                );


            if (!dueDateValue) {
                return;
            }


            const parts =
                dueDateValue.split('-');


            if (
                parts.length !== 3
            ) {
                return;
            }
            const dueDate =
                new Date(
                    parseInt(parts[0]),
                    parseInt(parts[1]) - 1,
                    parseInt(parts[2])
                );
            if (
                dueDate <= today
            ) {
                span.classList.add(
                    'highlight-today'
                );
            }
        });
}
/* =========================================================
   BOTTOM SCROLLBAR SYNC
========================================================= */
document.addEventListener(
    'DOMContentLoaded',
    function() {
        const bottomScroll =
            document.getElementById(
                'viewClientBottomScroll'
            );
        const bottomInner =
            document.getElementById(
                'viewClientBottomScrollInner'
            );
        const tableWrapper =
            document.querySelector(
                '.view-clients-table-wrapper'
            );
        if (
            !bottomScroll
            ||
            !bottomInner
            ||
            !tableWrapper
        ) {
            return;
        }
        function updateScrollWidth() {
            bottomInner.style.width =
                tableWrapper.scrollWidth
                + 'px';

        }
        updateScrollWidth();
        window.addEventListener(
            'resize',
            updateScrollWidth
        );
        bottomScroll.addEventListener(
            'scroll',
            function() {
                tableWrapper.scrollLeft =
                    bottomScroll.scrollLeft;
            }
        );
        tableWrapper.addEventListener(
            'scroll',
            function() {
                bottomScroll.scrollLeft =
                    tableWrapper.scrollLeft;
            }
        );
    }
);
/* =========================================================
   PAGE LOAD
========================================================= */
window.addEventListener(
    'load',
    function() {
        calculateTotalDue();
        calculateRecordCount();
        highlightDueDates();
    }
);
</script>
</body>
</html>"