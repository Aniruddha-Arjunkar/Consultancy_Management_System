No you getting it wrong Rescheduling doesn't mean we are going to Rescheduled interview where candidate get Rejected.
Scheduling candidate interview from the Start , Adding company name , job profile interview date , time from round 1.
For refernce in seniors project as user click on the Reschedule Interview button it redirect to reschedule-interview.php
----> "<?php 
session_start(); 

if (!isset($_SESSION['email'])) { 
    $_SESSION['msg'] = "You must log in first"; 
    header('location:login.php'); 
    exit(); 
} 
 
require_once 'db_connect.php'; 
include 'header.php'; 
 
 
// Check if an ID and status are provided 
if (isset($_GET['id']) && isset($_GET['status'])) { 
    $interview_id = intval($_GET['id']); 
    $status = mysqli_real_escape_string($conn, $_GET['status']); 
 
    // If the status is "Rescheduled", we need to display the form to update interview details 
    if ($status == 'Rescheduled') { 
        
        // Check if the form has been submitted for rescheduling 
        if ($_SERVER['REQUEST_METHOD'] == 'POST') { 
            
            // Get the updated details from the form 
            $company_name = mysqli_real_escape_string($conn, $_POST['company_name']); 
            $position = mysqli_real_escape_string($conn, $_POST['position']); 
            $interview_round = intval($_POST['interview_round']); 
            $interview_date = mysqli_real_escape_string($conn, $_POST['interview_date']); 
            $interview_time = mysqli_real_escape_string($conn, $_POST['interview_time']); 
            $remark = mysqli_real_escape_string($conn, $_POST['remark']); 
            $hr_name = mysqli_real_escape_string($conn, $_POST['hr_name']); 
            $interview_status = 'Rescheduled'; 

            // Update the interview details with the new information 
            $sql = "UPDATE tbl_placement  
                    SET company_name = '$company_name',  
                        position = '$position',  
                        interview_round = $interview_round,  
                        interview_date = '$interview_date',  
                        interview_time = '$interview_time',  
                        remark = '$remark',  
                        hr_name = '$hr_name',  
                        interview_status = '$interview_status' 
                    WHERE interview_id = $interview_id"; 
 
            if (mysqli_query($conn, $sql)) { 
                echo "<script>
                    alert('Interview rescheduled successfully.'); 
                    window.location.href='view-interview-schedule-student.php';
                </script>"; 
            } else { 
                echo "Error updating interview details: " . mysqli_error($conn); 
            } 
        } 
        
    } else { 
        
        // For other statuses update the status 
        $sql = "UPDATE tbl_placement 
                SET interview_status = '$status' 
                WHERE interview_id = $interview_id"; 
 
        if (mysqli_query($conn, $sql)) { 
            echo "<script>
                alert('Status updated successfully.'); 
                window.location.href='view-interview-schedule-student.php';
            </script>"; 
        } else { 
            echo "Error updating status: " . mysqli_error($conn); 
        } 
    } 
} 
 
mysqli_close($conn); 
