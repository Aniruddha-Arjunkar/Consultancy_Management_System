"<?php
session_start();

// Check if the user is logged in
if (!isset($_SESSION['email'])) {
    $_SESSION['msg'] = "You must log in first";
    header('location:login.php');
    exit();
}

// Handle logout
if (isset($_GET['logout'])) {
    session_destroy();
    unset($_SESSION['email']);
    header('location:login.php');
    exit();
}

// Include database connection
require_once 'db_connect.php';
include 'header.php';

// Check if 'id' is set in the URL and is numeric
if (isset($_GET['id']) && is_numeric($_GET['id'])) {
    $id = $_GET['id'];

    // Fetch the agreement details from the database
    $sql = "SELECT * FROM tbl_agreement WHERE Id = $id";
    $result = mysqli_query($conn, $sql);

    if (!$result) {
        die("Query failed: " . mysqli_error($conn));
    }

    if (mysqli_num_rows($result) > 0) {
        $row = mysqli_fetch_assoc($result);
    } else {
        echo "<p>No agreement found with the given ID.</p>";
        exit();
    }

    // Fetch placement details based on candidate_id
    $placement_sql = "SELECT * FROM tbl_placement WHERE candidate_id = $id";
    $placement_result = mysqli_query($conn, $placement_sql);

    if (!$placement_result) {
        die("Query failed: " . mysqli_error($conn));
    }

    // Fetch interview details based on interview_id from tbl_placement
    $interview_sql = "SELECT * FROM tbl_interview WHERE interview_id IN (SELECT interview_id FROM tbl_placement WHERE candidate_id = $id)";
    $interview_result = mysqli_query($conn, $interview_sql);

    if (!$interview_result) {
        die("Query failed: " . mysqli_error($conn));
    }

    // Step 1: Check if the candidate ever had a "Company Pay" payment
    $check_company_pay_sql = "SELECT 1 FROM tbl_payment WHERE client_Id = $id AND payment_type = 'Company Pay' LIMIT 1";
    $check_company_pay_result = mysqli_query($conn, $check_company_pay_sql);

    if (!$check_company_pay_result) {
        die("Query failed: " . mysqli_error($conn));
    }

    // Step 2: Set flag if the candidate has "Company Pay" history
    $had_company_pay = mysqli_num_rows($check_company_pay_result) > 0;

    // Step 3: Fetch payment records (exclude "Company Pay" if the candidate had one)
    if ($had_company_pay) {
        $payment_sql = "SELECT * FROM tbl_payment WHERE client_Id = $id AND payment_type != 'Company Pay'";
    } else {
        $payment_sql = "SELECT * FROM tbl_payment WHERE client_Id = $id ";
    }
    
    $payment_result = mysqli_query($conn, $payment_sql);

    if (!$payment_result) {
        die("Query failed: " . mysqli_error($conn));
    }

    // Calculate the total paid amount
    $total_paid_amount = 0;
    while ($payment = mysqli_fetch_assoc($payment_result)) {
        $total_paid_amount += (float)$payment['paid_amount'];
    }

    // Reset the pointer to the start of the result set for displaying the payment details
    mysqli_data_seek($payment_result, 0);  // Rewind the result set pointer
} else {
    echo "<p>Invalid ID provided.</p>";
    exit();
}
?>

