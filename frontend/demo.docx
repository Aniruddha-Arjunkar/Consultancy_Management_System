  `Id` bigint(20) UNSIGNED NOT NULL,
  `client_Id` text NOT NULL,
  `total_amount` decimal(10,2) NOT NULL,
  `paid_amount` decimal(10,2) DEFAULT 0.00,
  `due_amount` decimal(10,2) DEFAULT 0.00,
  `payment_date` date DEFAULT NULL,
  `due_date` date DEFAULT NULL,
  `payment_gateway` text DEFAULT NULL,
  `interview_id` int(11) DEFAULT NULL,
  `payment_type` text DEFAULT NULL,
  `status` enum('active','defaulted') DEFAULT 'active',
  `defaulter_note` text DEFAULT NULL,
  `tds_amount` decimal(10,2) DEFAULT 0.00,
  `tds_paid` tinyint(1) DEFAULT 0
) ENGINE=MyISAM DEFAULT CHARSET=latin1 COLLATE=latin1_swedish_ci;
ALTER TABLE `tbl_payment`
  ADD UNIQUE KEY `Id` (`Id`);
