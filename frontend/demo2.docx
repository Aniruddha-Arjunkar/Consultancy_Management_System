    <script>
    
    function showPaymentSection(id){
    document.querySelectorAll('.payment-category').forEach(s => s.style.display='none');
    document.getElementById(id).style.display='block';
}
showPaymentSection('paidSection');

function showMoreRows(button) {
    const table = button.closest('table');
    table.querySelectorAll('.extra-row').forEach(r => r.style.display='table-row');
    button.closest('.see-more-row').style.display = 'none';
}
        
        /* ================================
   ONLY ONE CANDIDATE SECTION OPEN
================================ */
function toggleOnlyOne(sectionId) {
    const sections = [
        'scheduledCandidatesSection',
        'completedCandidatesSection',
        'placedCandidatesSection',
        'rejectedCandidatesSection'
    ];

    sections.forEach(id => {
        const el = document.getElementById(id);
        if (id === sectionId) {
            el.style.display = (el.style.display === 'block') ? 'none' : 'block';
        } else {
            el.style.display = 'none';
        }
    });
}

/* ================================
   DROPDOWN CLICK EVENTS
================================ */
document.getElementById('toggleScheduledCandidates').addEventListener('click', function(e) {
    e.preventDefault();
    toggleOnlyOne('scheduledCandidatesSection');
});

document.getElementById('toggleCompletedCandidates').addEventListener('click', function(e) {
    e.preventDefault();
    toggleOnlyOne('completedCandidatesSection');
});

document.getElementById('togglePlacedCandidates').addEventListener('click', function(e) {
    e.preventDefault();
    toggleOnlyOne('placedCandidatesSection');
});

document.getElementById('toggleRejectedCandidates').addEventListener('click', function(e) {
    e.preventDefault();
    toggleOnlyOne('rejectedCandidatesSection');
});
        
        
    
function searchTable(inputId, tableId) {
    const input = document.getElementById(inputId);
    const filter = input.value.toLowerCase();
    const table = document.getElementById(tableId);
    const tr = table.getElementsByTagName("tr");

    for (let i = 1; i < tr.length; i++) {
        let found = false;
        const td = tr[i].getElementsByTagName("td");

        for (let j = 0; j < td.length; j++) {
            if (td[j].innerText.toLowerCase().includes(filter)) {
                found = true;
                break;
            }
        }
        tr[i].style.display = found ? "" : "none";
    }
}

    </script>
</body>
</html>"