<?php

/* =========================================================
   PAYMENT QUERY
========================================================= */

$sql = "

SELECT

    MAX(p.Id) AS payment_id,

    p.client_Id,

    'Nagpur' AS branch,

    'Consultancy' AS services,

    IF(
        p.payment_type = 'Company Pay',

        CONCAT(
            pl.company_name,
            ' (',
            pl.candidate_name,
            ')'
        ),

        CONCAT(
            pl.candidate_name,
            ' (',
            pl.company_name,
            ')'
        )
    ) AS cust_name,


    /* Associate ID - name matching */
(
    SELECT a2.Id
    FROM tbl_associate a2
    WHERE LOWER(TRIM(a2.company_name)) =
          LOWER(TRIM(pl.company_name))
    LIMIT 1
) AS associate_id,



    IF(
        p.payment_type = 'Company Pay',

        COALESCE(
            ag.phone,
            a.phone
        ),

        COALESCE(
            a.phone,
            ag.phone
        )
    ) AS cust_phone,


    p.total_amount,

    SUM(p.paid_amount) AS total_paid,


    (
        p.total_amount
        - SUM(p.paid_amount)
        - SUM(
            CASE
                WHEN p.tds_paid = 0
                THEN p.tds_amount
                ELSE 0
            END
        )
    ) AS due_amount,


    MAX(p.due_date) AS due_date


FROM tbl_payment p


LEFT JOIN tbl_placement pl
    ON p.interview_id = pl.interview_id


LEFT JOIN tbl_agreement ag
    ON pl.candidate_id = ag.id


LEFT JOIN tbl_associate a
    ON pl.candidate_id = a.Id


WHERE p.status != 'defaulted'


GROUP BY
    p.client_Id,
    p.total_amount


HAVING due_amount > 0



ORDER BY due_date ASC

";


$result = mysqli_query(
    $conn,
    $sql
);


if (!$result) {

    echo '

    <tr>

        <td
            colspan="9"
            class="view-client-no-data"
        >

            Error:
            ' .
            htmlspecialchars(
                mysqli_error($conn)
            )
            . '

        </td>

    </tr>

    ';

} elseif (
    mysqli_num_rows($result) > 0
) {


    while (
        $row = mysqli_fetch_assoc($result)
    ) {


        /* =================================================
           SKIP EMPTY NAME
        ================================================= */

        if (
            empty(
                $row['cust_name']
            )
        ) {

            continue;

        }


        /* =================================================
           TOTAL
        ================================================= */

        $total_due_amount +=
            (float)(
                $row['due_amount'] ?? 0
            );


        $total_records++;


        /* =================================================
           DUE DATE
        ================================================= */

        $dueDate = null;

        if (
            !empty(
                $row['due_date']
            )
        ) {

            try {

                $dueDate =
                    new DateTime(
                        $row['due_date']
                    );

            } catch (
                Exception $e
            ) {

                $dueDate = null;

            }

        }


        /* =================================================
           BRANCH COLOR LOGIC
        ================================================= */

        $branchClass = 'blue';

        $branchLower =
            strtolower(
                trim(
                    $row['branch'] ?? ''
                )
            );


