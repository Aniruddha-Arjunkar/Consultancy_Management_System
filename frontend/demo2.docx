                   onkeyup="searchTable('rejectedSearch','rejectedTable')">
        </div>
    </div>
</div>
                            
                            
                            <table class="table" id="rejectedTable">
                                <thead>
                                    <tr>
                                        <th>Candidate Name</th>
                                        <th>Interview Date</th>
                                        <th>Position</th>
                                        <th>Interview Time</th>
                                        <th>Rejection Reason</th>
                                        <th>Remark</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <?php if (count($rejected_candidates) > 0): ?>
                                        <?php foreach ($rejected_candidates as $candidate): ?>
                                            <tr>
                                                <td><?= htmlspecialchars($candidate['candidate_name']); ?></td>
                                                <td><?= htmlspecialchars($candidate['interview_date']); ?></td>
                                                <td><?= htmlspecialchars($candidate['position']); ?></td>
                                                <td><?= htmlspecialchars($candidate['interview_time']); ?></td>
                                                <td><?= htmlspecialchars($candidate['rejection_reason']); ?></td>
                                                <td><?= htmlspecialchars($candidate['remark']); ?></td>
                                            </tr>
                                        <?php endforeach; ?>
                                    <?php else: ?>
                                        <tr>
                                            <td colspan="6">No rejected candidates.</td>
                                        </tr>
                                    <?php endif; ?>
                                </tbody>
                            </table>
                        </section>
                    </div>
                </div>

                <!-- Update Button -->
                <a href="update-associate.php?id=<?= $row['Id']; ?>" class="btn btn-warning">Update</a>
