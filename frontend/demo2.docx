<!-- =========================================
     GST CALCULATION
========================================= -->
<script>
const gstType =
    document.getElementById('gst_type');
const amountInput =
    document.getElementById('amount');
const cgstInput =
    document.getElementById('cgst');
const sgstInput =
    document.getElementById('sgst');
const igstInput =
    document.getElementById('igst');
const totalInput =
    document.getElementById('total');
function calculateGST() {
    let amount =
        parseFloat(amountInput.value) || 0;
    let type =
        gstType.value;
    let cgst = 0;
    let sgst = 0;
    let igst = 0;
    let total = 0;
    /* =========================
       EXCLUSIVE
    ========================= */
    if (type === 'exclusive') {
        cgst =
            parseFloat(
                (amount * 0.09).toFixed(2)
            );
        sgst =
            parseFloat(
                (amount * 0.09).toFixed(2)
            );
        igst = 0;
        total =
            amount + cgst + sgst;
    }
    /* =========================
       NORMAL
    ========================= */
    else if (type === 'normal') {
        cgst = 0;
        sgst = 0;
        igst = 0;
        total =
            amount;
    }
    /* =========================
       INCLUSIVE
    ========================= */
    else if (type === 'inclusive') {
        const basicAmount =
            amount / 1.18;
        cgst =
            parseFloat(
                (basicAmount * 0.09).toFixed(2)
            );
        sgst =
            parseFloat(
                (basicAmount * 0.09).toFixed(2)
            );
        igst = 0;
        total =
            amount;
    }
    /* =========================
       IGST
    ========================= */
    else if (type === 'igst') {
        cgst = 0;
        sgst = 0;
        igst =
            parseFloat(
                (amount * 0.18).toFixed(2)
            );
        total =
            amount + igst;
    }
    /* =========================
       DISPLAY
    ========================= */
    cgstInput.value =
        cgst.toFixed(2);
    sgstInput.value =
        sgst.toFixed(2);
    igstInput.value =
        igst.toFixed(2);
    totalInput.value =
        total.toFixed(2);
}
/* =========================
   EVENTS
========================= */
gstType.addEventListener(
    'change',
    calculateGST
);
amountInput.addEventListener(
    'input',
    calculateGST
);
/* =========================
   INITIAL CALCULATION
========================= */
calculateGST();
</script>
