Seniors code file upload-document .php ---> "
<?php

session_start();
ob_start();

/* =========================
   LOGIN CHECK
========================= */

if (!isset($_SESSION['email'])) {
    $_SESSION['msg'] = "You must log in first";
    header('location:login.php');
    exit();
}


/* =========================
   LOGOUT
========================= */

if (isset($_GET['logout'])) {
    session_destroy();
    unset($_SESSION['email']);
    header('location:login.php');
    exit();
}


/* =========================
   EMPLOYEE ID
========================= */

if (isset($_GET['employee_id'])) {
    $employee_id = $_GET['employee_id'];
} else {
    die("No employee ID provided.");
}

/* =========================
   DATABASE
========================= */

require_once 'db_connect.php';
include 'header.php';


/* =========================
   DOCUMENT UPLOAD
========================= */

if ($_SERVER['REQUEST_METHOD'] == 'POST') {

    /* =========================
       DOCUMENT DETAILS
    ========================= */

    $document_type =
        $_POST['document_type'];

    $upload_dir =
        'uploads/' . $employee_id . '/';


    /* =========================
       CREATE DIRECTORY
    ========================= */

    if (!file_exists($upload_dir)) {
        mkdir(
            $upload_dir,
            0777,
            true
        );
    }


    /* =========================
       FILE DETAILS
    ========================= */

    $document_name =
        $_FILES['document']['name'];

    $document_tmp =
        $_FILES['document']['tmp_name'];

    $document_path =
        $upload_dir . $document_name;


    /* =========================
       PDF VALIDATION
    ========================= */

    $file_ext =
        pathinfo(
            $document_name,
            PATHINFO_EXTENSION
        );

    if ($file_ext != 'pdf') {
        echo "
            <div class='alert alert-danger'>
                Error: Only PDF files are allowed!
            </div>
        ";

    } else {


        /* =========================
           MOVE FILE
        ========================= */

        if (
            move_uploaded_file(
                $document_tmp,
                $document_path
            )
        ) {

            /* =========================
               DATABASE INSERT
            ========================= */

            $sql = "
                INSERT INTO employee_documents
                (
                    employee_id,
                    document_type,
                    document_name,
                    file_path
                )
                VALUES
                (
                    '$employee_id',
                    '$document_type',
                    '$document_name',
                    '$document_path'
                )
            ";

            if ($conn->query($sql) === TRUE) {
                echo "
                    <div class='alert alert-success'>
                        Document uploaded successfully.
                    </div>
                ";
            } else {
                echo "
                    <div class='alert alert-danger'>
                        Error: " .
                        htmlspecialchars(
                            $conn->error
                        ) .
                    "
                    </div>
                ";
            }
        } else {
            echo "
                <div class='alert alert-danger'>
                    Error uploading document.
                </div>
            ";
        }
    }
}
$conn->close();
?>

<section id="main-content">
    <section class="wrapper">
        <div class="reg-w3">
            <div class="refollowup-card">

                <div class="refollowup-header">
