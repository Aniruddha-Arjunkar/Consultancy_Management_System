            $branchLower === 'nagpur'
        ) {

            $branchClass = 'blue';

        } elseif (
            $branchLower === 'bramhapuri'
        ) {

            $branchClass = 'green';

        } elseif (
            $branchLower === 'chandrapur'
            ||
            $branchLower === 'chandreapur'
        ) {

            $branchClass = 'orange';

        } else {

            $branchClass = 'blue';

        }

?>

