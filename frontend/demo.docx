  <script>
  document.addEventListener(
    "DOMContentLoaded",
    function () {
          const searchInput =
            document.getElementById(
                "txt_searchall"
            );
          const table =
            document.getElementById(
                "payments-table"
            );
          if (
            !searchInput ||
            !table
        ) {
            return;
        }
          searchInput.addEventListener(
            "input",
            function () {
                  const searchValue =
                    this.value
                        .toLowerCase()
                        .trim();
                  const rows =
                    table.querySelectorAll(
                        "tbody tr"
                    );
                  let serial = 1;
                  rows.forEach(
                    function (row) {
                          const noData =
                            row.querySelector(
                                ".view-client-no-data"
                            );
                          if (noData) {
                            return;
                        }
                          const rowText =
                            row.textContent
                                .toLowerCase();
                          if (
                            searchValue === ""
                            ||
                            rowText.includes(
                                searchValue
                            )
                        ) {
                              row.style.display =
                                "";
                              const sr =
                                row.querySelector(
                                    ".view-client-sr"
                                );
                              if (sr) {
                                  sr.textContent =
                                    serial++;
                              }
                          } else {
                              row.style.display =
                                "none";
                          }
                      }
                );
              }
        );
      }
);
  /* DATE FILTER */
  document.addEventListener(
    "DOMContentLoaded",
    function () {
          const startDate =
            document.getElementById(
                "start_date"
            );
          const endDate =
            document.getElementById(
                "end_date"
            );
          const table =
            document.getElementById(
                "payments-table"
            );
          if (
            !startDate ||
            !endDate ||
            !table
        ) {
            return;
        }
          function updateSerialNumbers() {
              const rows =
                table.querySelectorAll(
                    "tbody tr"
                );
              let serial = 1;
              rows.forEach(
                function (row) {
                      if (
                        row.style.display !==
                        "none"
                    ) {
                          const sr =
                            row.querySelector(
                                ".view-client-sr"
                            );
                          if (sr) {
                              sr.textContent =
                                serial++;
                          }
                      }
                  }
            );
          }
          window.filterByDate =
            function () {
                  const from =
                    startDate.value;
                  const to =
                    endDate.value;
                  const rows =
                    table.querySelectorAll(
                        "tbody tr"
                    );
                  rows.forEach(
                    function (row) {
                          const dateCell =
                            row.querySelector(
                                ".view-client-date-cell"
                            );
                          if (!dateCell) {
                            return;
                        }
                          const dateText =
                            dateCell.textContent
                                .trim();
                          if (!dateText) {
                            return;
                        }
                          const rowDate =
                            new Date(
                                dateText
                            );
                          let hide = false;
                          if (
                            from
                            &&
                            rowDate <
                            new Date(from)
                        ) {
                              hide = true;
                          }
                          if (
                            to
                            &&
                            rowDate >
                            new Date(to)
                        ) {
                              hide = true;
                          }
                          row.style.display =
                            hide
                                ? "none"
                                : "";
                      }
                );
                  updateSerialNumbers();
              };
      }
);
  /* BOTTOM SCROLL */
  document.addEventListener(
    "DOMContentLoaded",
    function () {
          const bottomScroll =
            document.getElementById(
                "viewClientBottomScroll"
            );
          const bottomInner =
            document.getElementById(
                "viewClientBottomScrollInner"
            );
          const tableWrapper =
            document.querySelector(
                ".view-clients-table-wrapper"
            );
          if (
            !bottomScroll ||
            !bottomInner ||
            !tableWrapper
        ) {
            return;
        }
          function updateScrollWidth() {
              bottomInner.style.width =
                tableWrapper.scrollWidth + "px";
          }
          updateScrollWidth();
          window.addEventListener(
            "resize",
            updateScrollWidth
        );
          bottomScroll.addEventListener(
            "scroll",
            function () {
                  tableWrapper.scrollLeft =
                    bottomScroll.scrollLeft;
              }
        );
          tableWrapper.addEventListener(
            "scroll",
            function () {
                  bottomScroll.scrollLeft =
                    tableWrapper.scrollLeft;
              }
        );
      }
);
  </script>
  <script src="js/bootstrap.js"></script>
  <script src="js/jquery.dcjqaccordion.2.7.js"></script>
  <script src="js/scripts.js"></script>
  <script src="js/jquery.slimscroll.js"></script>
  <script src="js/jquery.nicescroll.js"></script>
  <script src="js/jquery.scrollTo.js"></script>
  <script src="js/search.js"></script>
  </body>
</html>
