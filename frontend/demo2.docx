    Edit Base amount is working perfectly now in candidate datail page . Now we also have to implement edit amount 
    button in View Associate page > Associate company detail (ViewAssociateDetail.jsx) > Payment detail section . Dont make any change by 
    yourself.




                        <label htmlFor="defaulter-note">Reason</label>
                        <textarea
                            id="defaulter-note"
                            rows={4}
                            value={defaulterNote}
                            onChange={(event) => setDefaulterNote(event.target.value)}
                            maxLength={1000}
                            required
                        />

                        {defaulterError && (
                            <p role="alert">{defaulterError}</p>
                        )}

                        <div className="defaulter-modal-actions">
                            <button
                                type="button"
                                className="defaulter-cancel-btn"
                                disabled={markingDefaulter}
                                onClick={() => setDefaulterTarget(null)}
                            >
                                Cancel
                            </button>
                            <button
                                type="submit"
                                className="defaulter-submit-btn"
                                disabled={markingDefaulter}
                            >
                                {markingDefaulter ? "Saving..." : "Submit"}
                            </button>
                        </div>
                    </form>
                </div>
            )}
        </section>


    );
};
export default DuePayment;


