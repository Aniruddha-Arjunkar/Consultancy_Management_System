// ===== ATTENDANCE CALCULATION (COMMON FOR ALL) =====
$days_in_month = 0; // default value
$num_days_attended = 0;
$month_num = $year_full = $month_short = $year_short = null;

if (!empty($selected_month)) {
    $timestamp = strtotime($selected_month);

    $month_num   = date('m', $timestamp);
    $year_full   = date('Y', $timestamp);
    $month_short = date('M', $timestamp);
    $year_short  = substr($year_full, 2);

    $attQuery = mysqli_query($conn, "
        SELECT SUM(
            CASE 
                WHEN attendance='P' THEN 1
                WHEN attendance='HD' THEN 0.5
                ELSE 0
            END
        ) AS attended_days
        FROM tbl_emp_attendance
        WHERE employee_id = $employee_id
        AND attendance_month = '$month_short'
        AND attendance_year = '$year_short'
    ");

    $attData = mysqli_fetch_assoc($attQuery);
    $num_days_attended = $attData['attended_days'] ?? 0;
}




// âœ… Corrected numberToWords() function (Indian format)
function numberToWords($num)
{
    $num = (int)$num;
    if ($num == 0) return 'Zero';

    $ones = array(
        '', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine',
        'Ten', 'Eleven', 'Twelve', 'Thirteen', 'Fourteen', 'Fifteen', 'Sixteen', 'Seventeen', 'Eighteen', 'Nineteen'
    );

    $tens = array('', '', 'Twenty', 'Thirty', 'Forty', 'Fifty', 'Sixty', 'Seventy', 'Eighty', 'Ninety');

    $levels = array('', 'Thousand', 'Lakh', 'Crore');

    $words = '';

    $level = 0;

    while ($num > 0) {
        $divider = ($level == 0) ? 1000 : 100;
        $part = $num % $divider;
        $num = floor($num / $divider);

        if ($part > 0) {
            $segment = '';

            if ($part > 99) {
                $segment .= $ones[floor($part / 100)] . ' Hundred ';
                $part = $part % 100;
            }

            if ($part > 19) {
                $segment .= $tens[floor($part / 10)] . ' ';
                $segment .= $ones[$part % 10] . ' ';
            } else {
                $segment .= $ones[$part] . ' ';
            }

            if ($levels[$level] != '') {
                $segment .= $levels[$level] . ' ';
            }

            $words = $segment . $words;
        }

        $level++;
    }

    return trim($words) . '';
}

