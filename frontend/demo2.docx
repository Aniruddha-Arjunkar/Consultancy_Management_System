/* =========================================================
   ROUNDS MODAL
========================================================= */

.rounds-modal {
    display: none;
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, .72);
    z-index: 99999;
    align-items: center;
    justify-content: center;
    padding: 20px;
    box-sizing: border-box;
    backdrop-filter: blur(3px);
}

.rounds-modal-content {
    position: relative;
    width: 100%;
    max-width: 850px;
    max-height: 88vh;
    background: #fff;
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
        0 25px 60px rgba(15, 23, 42, .30),
        0 5px 20px rgba(15, 23, 42, .15);
    animation: roundsModalOpen .22s ease-out;
    box-sizing: border-box;
}

@keyframes roundsModalOpen {

    from {
        opacity: 0;
        transform: translateY(15px) scale(.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }

}

.rounds-modal-header {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px;
    background: linear-gradient(135deg, #4f46e5, #6366f1);
    color: #fff;
    box-sizing: border-box;
}

.rounds-modal-header h3 {
    margin: 0;
    color: #fff;
    font-size: 18px;
    line-height: 23px;
    font-weight: 700;
}

.rounds-modal-header button {
    width: 34px;
    height: 34px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background: rgba(255, 255, 255, .18);
    color: #fff;
    font-size: 25px;
    line-height: 30px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition:
        background .2s ease,
        transform .15s ease;
}

.rounds-modal-header button:hover {
    background: rgba(255, 255, 255, .30);
    transform: rotate(90deg);
}

.round-details {
    padding: 20px;
    max-height: calc(88vh - 64px);
    overflow-y: auto;
    box-sizing: border-box;
    scrollbar-width: thin;
    scrollbar-color: #cbd5e1 transparent;
}

.round-details::-webkit-scrollbar {
    width: 7px;
}

.round-details::-webkit-scrollbar-track {
    background: transparent;
}

.round-details::-webkit-scrollbar-thumb {
    background: #cbd5e1;
    border-radius: 10px;
}

.round-detail {
    display: none;
    animation: roundFade .18s ease;
}

@keyframes roundFade {

    from {
        opacity: 0;
        transform: translateY(5px);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }

}

.round-detail-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid #e5e7eb;
}

.round-detail-title h4 {
    margin: 0;
    color: #1e293b;
    font-size: 17px;
    line-height: 22px;
    font-weight: 700;
}

.round-status {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 30px;
    padding: 5px 12px;
    border-radius: 20px;
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    color: #166534;
    font-size: 12px;
    line-height: 16px;
    font-weight: 700;
    white-space: nowrap;
}

.round-detail-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
}

.round-box {
    min-width: 0;
    min-height: 70px;
    padding: 12px 14px;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 9px;
    box-sizing: border-box;
    transition:
        background .2s ease,
        border-color .2s ease,
        box-shadow .2s ease;
}

.round-box:hover {
    background: #fff;
    border-color: #c7d2fe;
    box-shadow:
        0 3px 10px rgba(15, 23, 42, .06);
}

.round-box span {
    display: block;
    margin-bottom: 5px;
    color: #64748b;
    font-size: 11px;
    line-height: 14px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .3px;
}

.round-box strong {
    display: block;
    color: #1e293b;
    font-size: 13px;
    line-height: 18px;
    font-weight: 700;
    word-break: break-word;
}

.round-box:first-child {
    background: #eef2ff;
    border-color: #c7d2fe;
}

.round-box:first-child span {
    color: #4f46e5;
}

.round-box:first-child strong {
    color: #312e81;
}


