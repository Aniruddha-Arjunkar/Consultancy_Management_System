            <?php
              $clientWhere = "WHERE cgst > 0 AND sgst > 0";
              if (
                $_SESSION['role'] !== 'super_admin'
                &&
                !empty($_SESSION['branch'])
            ) {
                  $branch = mysqli_real_escape_string(
                    $conn,
                    $_SESSION['branch']
                );
                  $clientWhere .= "
                    AND branch = '$branch'
                ";
              }
              if (
                isset($_POST['but_search'])
            ) {
                  $fromDate =
                    $_POST['fromDate'] ?? '';
                  $endDate =
                    $_POST['endDate'] ?? '';
                  if (
                    !empty($fromDate)
                    &&
                    !empty($endDate)
                ) {
                      $safeFromDate =
                        mysqli_real_escape_string(
                            $conn,
                            $fromDate
                        );
                      $safeEndDate =
                        mysqli_real_escape_string(
                            $conn,
                            $endDate
                        );
                      $clientWhere .= "
                        AND due_date
                        BETWEEN '$safeFromDate'
                        AND '$safeEndDate'
                    ";
                  }
              }
              $sql = "
                  SELECT *
                  FROM (
                      SELECT
                          'Placement' AS source,
                          a.Id,
                          'Nagpur' AS branch,
                          'Consultancy' AS services,
                          a.name,
                          a.phone,
                          a.shipping_address AS address,
                          p.candidate_pay_date AS date,
                          IFNULL(
                              CAST(
                                p.candidate_pay_amount
                                AS DECIMAL(10,2)
                            )
                              +
                              IFNULL(
                                p.candidate_gst_amount,
                                0
                            ),
                              0
                          ) AS amount,
                          IFNULL(
                              (
                                  SELECT
                                    SUM(
                                        CAST(
                                            pmt.paid_amount
                                            AS DECIMAL(10,2)
                                        )
                                    )
                                  FROM tbl_payment pmt
                                  WHERE pmt.client_Id IN (
                                      SELECT candidate_id
                                      FROM tbl_placement
                                      WHERE candidate_name = a.name
                                  )
                                  AND pmt.payment_type =
                                    'Candidate Pay'
                              ),
                              0
                          ) AS paid_amount,
                          IFNULL(
                              (
                                  SELECT
                                    SUM(
                                        pmt.tds_amount
                                    )
                                  FROM tbl_payment pmt
                                  WHERE pmt.client_Id IN (
                                      SELECT candidate_id
                                      FROM tbl_placement
                                      WHERE candidate_name = a.name
                                  )
                                  AND pmt.payment_type =
                                    'Candidate Pay'
                              ),
                              0
                          ) AS tds_amount
                      FROM tbl_agreement a
                      LEFT JOIN tbl_placement p
                          ON p.candidate_name = a.name
                      WHERE
                          a.shipping_address IS NOT NULL
                          AND a.shipping_address != ''
                          AND IFNULL(
                            p.candidate_gst_amount,
                            0
                        ) > 0
                      GROUP BY p.candidate_id
                      HAVING
                        amount >
                        (
                            paid_amount
                            +
                            IFNULL(
                                tds_amount,
                                0
                            )
                        )
                      UNION ALL
                      SELECT
                          'Consultant' AS source,
                          asoc.Id,
                          'Nagpur' AS branch,
                          'Consultancy' AS services,
                          CONCAT(
                            asoc.company_name,
                            ' (',
                            p.candidate_name,
                            ')'
                        ) AS name,
                          asoc.phone,
                          asoc.shipping_address AS address,
                          p.company_pay_date AS date,
                          CAST(
                            p.company_pay_amount
                            AS DECIMAL(10,2)
                        )
                        +
                        IFNULL(
                            p.company_gst_amount,
                            0
                        ) AS amount,
                          SUM(
                            CAST(
                                pay.paid_amount
                                AS DECIMAL(10,2)
                            )
                        ) AS paid_amount,
                          IFNULL(
                            SUM(
                                pay.tds_amount
                            ),
                            0
                        ) AS tds_amount
                      FROM tbl_associate asoc
                      INNER JOIN tbl_placement p
                          ON p.company_name =
                           asoc.company_name
                      INNER JOIN tbl_payment pay
                          ON (
                            pay.client_Id =
                            p.candidate_id
                              OR
                              pay.interview_id =
                            p.interview_id
                        )
                          AND pay.payment_type =
                            'Company Pay'
                          AND pay.status =
                            'active'
                      WHERE
                          asoc.shipping_address IS NOT NULL
                          AND asoc.shipping_address != ''
                          AND IFNULL(
                            p.company_gst_amount,
                            0
                        ) > 0
                      GROUP BY p.candidate_id
                      HAVING
                        amount >
                        (
                            paid_amount
                            +
                            IFNULL(
                                tds_amount,
                                0
                            )
                        )
                  ) AS final_data
              ";
              if (
                $_SESSION['role'] == 'HR'
            ) {
                  $sql .= "
                    WHERE source != 'Pest Control'
                ";
              }
              $sql .= "
                ORDER BY
                date DESC,
                source ASC
            ";
              $result =
                mysqli_query(
                    $conn,
                    $sql
                );
              if (!$result) {
                  die(
                    "Database Error: "
                    .
                    mysqli_error($conn)
                );
              }
              $total_records =
                mysqli_num_rows(
                    $result
