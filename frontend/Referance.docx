/* =========================================================
   SHUL DASHBOARD CSS
========================================================= */

* {
    box-sizing: border-box;
    font-size: 13px;
}

html,
body {
    margin: 0;
    padding: 0;
    font-family:
        "Segoe UI",
        Tahoma,
        Arial,
        sans-serif;
    background: #f5f7fb;
    color: #1e293b;
     overflow-x: hidden;
}



a {
    text-decoration: none;
}

button,
input {
    font-family: inherit;
}


/* =========================================================
   MAIN APP
========================================================= */

.shul-app-layout {
    min-height: 100vh;
    background: #f5f7fb;
}


/* =========================================================
   HEADER
========================================================= */

.shul-header {
    height: 62px;
    background: #fff;


    display: flex;

    position: fixed;

    top: 0;
    left: 0;
    right: 0;

    z-index: 9999;
}


/* =========================================================
   HEADER LEFT
========================================================= */

.shul-header-left {
    width: 260px;
    min-width: 260px;

    background: #1748c7;

    color: #fff;

    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 0 14px;
}


.shul-brand {
    display: flex;
    align-items: center;

    gap: 9px;

    min-width: 0;
}


.shul-brand img {
   
    width:48px;

    height:48px;

    border-radius:10px;

    background:white;

    display:flex;

    justify-content:center;

    align-items:center;

    color:white;

}


.shul-brand-text {
    line-height: 1;
}


.shul-brand-title {
    font-size: 17px;
    font-weight: 800;
}


.shul-brand-sub {
    font-size: 10px;

    opacity: .9;

    margin-top: 4px;
}


.shul-sidebar-toggle {
    width: 32px;
    height: 35px;

    border: 0;

    background: transparent;

    color: #fff;

    font-size: 22px;
    font-weight: 700;

    cursor: pointer;

    border-radius: 7px;
}


.shul-sidebar-toggle:hover {
    background: rgba(255,255,255,.12);
}


/* =========================================================
   HEADER CONTENT
========================================================= */

.shul-header-content {
    flex: 1;

    min-width: 0;

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 0 18px 0 24px;
}


.shul-header-greeting {
    min-width: 0;
}


.shul-greeting-title {
    font-size: 15px;

    font-weight: 700;

    color: #1e293b;
}


.shul-greeting-date {
    font-size: 11px;

    color: #71809b;

    margin-top: 3px;
}


/* =========================================================
   HEADER ACTIONS
========================================================= */

.shul-header-actions {
    display: flex;

    align-items: center;

    gap: 9px;
}


/* SEARCH */

.shul-search-wrap {
    width: 230px;

    position: relative;
}


.shul-search-icon {
    position: absolute;

    left: 13px;
    top: 10px;

    font-size: 13px;

    z-index: 2;
}


.shul-search-wrap input {
    width: 100%;
    height: 39px;

    border: 1px solid #dfe5ef;

    border-radius: 10px;

    background: #f8faff;

    padding: 0 13px 0 35px;

    outline: none;

    color: #344054;

    font-size: 13px;
}


.shul-search-wrap input:focus {
    border-color: #8da9ff;

    box-shadow:
        0 0 0 3px
        rgba(79,70,229,.08);
}


.global-search-results {
    position:absolute;
    top:45px;
    right:0;
    /*width:330px;*/
    background:white;
    border-radius:10px;
    box-shadow:0 8px 25px rgba(0,0,0,.15);
    z-index:9999;
    max-height:400px;
    overflow-y:auto;
}
.global-search-item{

    padding:12px 15px;
    cursor:pointer;
    border-bottom:1px solid #eee;

}

/* LIVE */

.shul-live-badge {
    height: 29px;

    padding: 0 11px;

    border-radius: 18px;

    background: #e5f9ed;

    color: #0d9b56;

    font-size: 11px;

    font-weight: 700;

    display: flex;

    align-items: center;

    gap: 6px;
}


.shul-live-badge span {
    width: 7px;
    height: 7px;

    border-radius: 50%;

    background: #18b86b;
}


/* ICON BUTTON */

.shul-icon-button {
    width: 39px;
    height: 39px;

    border: 1px solid #e2e7f0;

    border-radius: 10px;

    background: #fff;

    cursor: pointer;

    position: relative;

    font-size: 15px;
}


.shul-icon-button:hover {
    background: #f8fafc;
}


/* NOTIFICATION */

.notification-button i {
    position: absolute;

    width: 6px;
    height: 6px;

    background: #ef4444;

    border-radius: 50%;

    right: 7px;
    top: 7px;
}


/* =========================================================
   PROFILE
========================================================= */

.shul-profile-wrap {
    position: relative;
}


.shul-profile-button {
    height: 40px;

    min-width: 150px;

    border: 1px solid #e2e7f0;

    border-radius: 10px;

    background: #fff;

    display: flex;

    align-items: center;

    gap: 8px;

    padding: 3px 9px;

    cursor: pointer;

    text-align: left;
}


.shul-avatar {
    width: 32px;
    height: 32px;

    border-radius: 50%;

    display: flex;

    align-items: center;
    justify-content: center;

    background: #6366f1;

    color: #fff;

    font-weight: 800;

    font-size: 13px;
}


.shul-profile-copy {
    display: flex;

    flex-direction: column;

    line-height: 1.2;

    flex: 1;

    min-width: 0;
}


.shul-profile-copy strong {
    font-size: 11px;

    color: #344054;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


.shul-profile-copy small {
    font-size: 12px;

    color: #6366f1;

    margin-top: 2px;
}


.shul-profile-arrow {
    font-size: 8px;

    color: #71809b;
}


.shul-profile-menu {
    display: none;

    position: absolute;

    right: 0;
    top: 47px;

    width: 190px;

    background: #fff;

    border: 1px solid #e5e7eb;

    border-radius: 11px;

    box-shadow:
        0 15px 40px
        rgba(15,23,42,.12);

    padding: 6px;

    z-index: 10000;
}


.shul-profile-menu.open {
    display: block;
}


.shul-profile-menu a {
    display: block;

    padding: 10px;

    border-radius: 8px;

    color: #475569;

    font-size: 12px;
}


.shul-profile-menu a:hover {
    background: #f8fafc;
}


.shul-profile-menu a.danger {
    color: #ef4444;
}


/* =========================================================
   SIDEBAR
========================================================= */

.shul-sidebar-scroll {
    position: fixed;

    left: 0;

    top: 62px;

    bottom: 0;

    width: 260px;

    background: #1748c7;

    overflow-y: auto;
    overflow-x: hidden;

    z-index: 9998;

    transition:
        width .25s ease,
        left .25s ease;

    scrollbar-width: thin;

    scrollbar-color:
        rgba(255,255,255,.25)
        transparent;
}


.shul-sidebar-scroll::-webkit-scrollbar {
    width: 5px;
}


.shul-sidebar-scroll::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,.25);

    border-radius: 10px;
}


.php-sidebar-navigation {
    padding: 10px;
}


.sidebar-menu {
    list-style: none;

    padding: 0 !important;

    margin: 0 !important;
}


.sidebar-menu li {
    list-style: none;
}


/* =========================================================
   SIDEBAR ITEMS
========================================================= */

.sidebar-menu > li {
    margin-bottom: 4px;
    font-size: 10px;
}


.sidebar-menu > li > a,
.sidebar-menu li.sub-menu > a {
    min-height: 43px;

    border-radius: 9px;

    color: #fff !important;

    display: flex;

    align-items: center;

    gap: 10px;

    padding: 0 12px !important;

    text-decoration: none !important;

    font-size: 13.5px !important;

    transition:
        background .2s ease,
        transform .2s ease;

    position: relative;
}


.sidebar-menu > li > a:hover,
.sidebar-menu li.sub-menu > a:hover {
    background:
        rgba(255,255,255,.13)
        !important;
}


.sidebar-menu > li > a.active {
    background: #4f46e5 !important;

    box-shadow:
        0 5px 15px
        rgba(0,0,0,.08);
}


.sidebar-menu li > a i {
    width: 20px;

    min-width: 20px;

    text-align: center;

    color: #fff;

    font-size: 13px;
}


.sidebar-menu li.sub-menu > a::after {
    content: "⌄";

    margin-left: auto;

    font-size: 11px;

    opacity: .9;

    transition:
        transform .2s ease;
}


.sidebar-menu li.sub-menu.open > a::after {
    transform:
        rotate(180deg);
}


/* =========================================================
   MODULE LABEL
========================================================= */

.sidebar-section-label {
    color: #dbe7ff;

    font-size: 9px;

    font-weight: 800;

    letter-spacing: .8px;

    padding:
        15px 7px 7px;

    user-select: none;
}


/* =========================================================
   SUBMENU
========================================================= */

.sidebar-menu ul.sub {
    display: none;

    list-style: none;

    padding: 4px;

    margin:
        2px 0 6px 12px;

    background:
        rgba(0,0,0,.08);

    border-radius: 8px;
}


.sidebar-menu li.sub-menu.open > ul.sub {
    display: block;
}


.sidebar-menu ul.sub li {
    margin: 1px 0;
}


.sidebar-menu ul.sub li > a {
    min-height: 33px;

    display: flex;

    align-items: center;

    color: #fff !important;

    text-decoration: none !important;

    border-radius: 7px;

    padding:
        6px 9px !important;

    font-size: 12.5px !important;

    transition:
        background .2s ease;
}


.sidebar-menu ul.sub li > a:hover {
    background:
        rgba(255,255,255,.12)
        !important;
}


/* nested submenu */

.sidebar-menu ul.sub li.sub-menu > a::after {
    content: "⌄";

    margin-left: auto;

    font-size: 9px;
}


.sidebar-menu ul.sub li.sub-menu.open > ul.sub {
    display: block;
}


.sidebar-menu ul.sub ul.sub {
    margin-left: 9px;
}


/* =========================================================
   BADGE
========================================================= */

.sidebar-menu .badge {
    margin-left: 25px;

    background: #ef4444;

    color: #fff;

    border-radius: 12px;

    font-size: 9px;

    font-weight: 700;

    line-height: 1;

    padding: 4px 6px;

    min-width: 18px;

    text-align: center;
}


.latest-sender {
    display: block;

    color: #dbe7ff;

    font-size: 9px;

    padding:
        0 12px 4px 42px;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
}


/* LOGOUT */

.sidebar-menu .logout-link {
    margin-top: 5px;
}


.sidebar-menu .logout-link:hover {
    background:
        rgba(239,68,68,.22)
        !important;
}


/* =========================================================
   COLLAPSED SIDEBAR
========================================================= */

.sidebar-collapsed-state
.shul-sidebar-scroll {
    width: 74px;
}


.sidebar-collapsed-state
.shul-main-content {
    margin-left: 74px;
}


.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-section-label,

.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu > li > a span,

.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu > li.sub-menu > a span,

.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu > li.sub-menu > a::after,

.sidebar-collapsed-state
.shul-sidebar-scroll
.latest-sender {
    display: none;
}


.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu > li > a,

.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu > li.sub-menu > a {
    justify-content: center;

    padding: 0 !important;
}


.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu > li {
    position: relative;
}


.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu .badge {
    position: absolute;

    right: 5px;

    top: 3px;

    font-size: 8px;

    padding: 3px 5px;
}


.sidebar-collapsed-state
.shul-sidebar-scroll
.sidebar-menu ul.sub {
    display: none !important;
}


/* =========================================================
   MOBILE OVERLAY
========================================================= */

.shul-sidebar-overlay {
    display: none;
}


/* =========================================================
   TABLET
========================================================= */

@media (max-width: 1150px) {

    .shul-search-wrap {
        width: 180px;
    }


    .shul-greeting-title {
        font-size: 16px;
        visibility: hidden;
    }


    .shul-kpi-grid {
        grid-template-columns:
            repeat(2,minmax(0,1fr));
    }

    .shul-greeting-date{
        visibility: hidden;
    }

}


@media (max-width: 768px) {

    /* =====================================================
       DEFAULT / COLLAPSED
       BLUE HEADER = 74px
    ===================================================== */

    .shul-header-left {
        width: 74px !important;
        min-width: 74px !important;
        max-width: 74px !important;

        flex: 0 0 74px !important;

        height: 58px !important;

        padding: 0 !important;
        margin: 0 !important;

        position: relative !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        overflow: hidden !important;

        transition:
            width .25s ease,
            min-width .25s ease,
            max-width .25s ease !important;

        z-index: 10001 !important;
    }


    /* =====================================================
       DEFAULT LOGO
    ===================================================== */

    .shul-brand {
        width: 45px !important;
        min-width: 45px !important;

        height: 58px !important;

        padding: 0 !important;
        margin: 0 !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
    }

    .shul-brand img {
        width: 40px !important;
        height: 40px !important;

        border-radius: 10px !important;
    }

    /* SHUL TEXT HIDDEN */
    .shul-brand-text {
        display: none !important;
    }


    /* =====================================================
       TOGGLE - COLLAPSED
    ===================================================== */

    .shul-sidebar-toggle {
        position: absolute !important;

        right: 3px !important;
        top: 50% !important;

        transform: translateY(-50%) !important;

        width: 25px !important;
        height: 34px !important;

        padding: 0 !important;
        margin: 0 !important;

        border: 0 !important;
        border-radius: 6px !important;

        background: rgba(255,255,255,.12) !important;

        color: #fff !important;

        font-size: 18px !important;

        display: flex !important;
        align-items: center !important;
        justify-content: center !important;

        z-index: 10002 !important;
    }


    /* =====================================================
       SIDEBAR DEFAULT
    ===================================================== */

    .shul-sidebar-scroll {

        width: 74px !important;
        min-width: 74px !important;
        max-width: 74px !important;

        transition:
            width .25s ease,
            min-width .25s ease,
            max-width .25s ease !important;
    }


    /* =====================================================
       HEADER CONTENT
    ===================================================== */

    .shul-header-content {
        flex: 1 1 auto !important;
        min-width: 0 !important;

        transition: all .25s ease !important;
    }     /* =====================================================
       MAIN CONTENT DEFAULT
    ===================================================== */

    .shul-main-content {
        margin-left: 74px !important;
        width: calc(100% - 74px) !important;

        transition:
            margin-left .25s ease,
            width .25s ease !important;
    }


    /* =====================================================
       EXPANDED STATE
       JS ALREADY ADDS:
       sidebar-mobile-open
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-header-left {

        width: 260px !important;
        min-width: 260px !important;
        max-width: 260px !important;

        flex: 0 0 260px !important;

        justify-content: flex-start !important;

        padding-left: 12px !important;

        transition:
            width .25s ease,
            min-width .25s ease,
            max-width .25s ease !important;
    }


    /* =====================================================
       EXPANDED SHUL BRAND
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-brand {

        width: auto !important;
        min-width: 0 !important;

        display: flex !important;

        justify-content: flex-start !important;

        gap: 10px !important;
    }


    /* LOGO */
    .shul-app-layout.sidebar-mobile-open
    .shul-brand img {

        width: 40px !important;
        height: 40px !important;
    }


    /* SHOW SHUL TEXT */
    .shul-app-layout.sidebar-mobile-open
    .shul-brand-text {

        display: block !important;

        white-space: nowrap !important;
        visibility: visible !important;
        opacity: 1 !important;
    }


    .shul-app-layout.sidebar-mobile-open
    .shul-brand-title {

        display: block !important;

        font-size: 20px !important;
        font-weight: 700 !important;

        line-height: 20px !important;

        color: #fff !important;
    }


    .shul-app-layout.sidebar-mobile-open
    .shul-brand-sub {

        display: block !important;

        font-size: 9px !important;

        line-height: 12px !important;

        color: #fff !important;
    }


    /* =====================================================
       TOGGLE POSITION WHEN EXPANDED
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-toggle {

        right: 8px !important;

        width: 32px !important;
        height: 36px !important;

        font-size: 20px !important;
    }


    /* =====================================================
       EXPANDED SIDEBAR
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll {

        width: 260px !important;
        min-width: 260px !important;
        max-width: 260px !important;
    }


    /* =====================================================
       EXPANDED MAIN CONTENT
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-main-content {

        margin-left: 260px !important;
        width: calc(100% - 260px) !important;
    }


    /* =====================================================
       COLLAPSED SIDEBAR - ICON ONLY
    ===================================================== */

    .shul-sidebar-scroll
    .sidebar-menu > li > a span,
    .shul-sidebar-scroll
    .sidebar-menu > li.sub-menu > a span {

        display: none !important;
    }

    .shul-sidebar-scroll
    .sidebar-menu > li.sub-menu > a::after {

        display: none !important;
    }

    .shul-sidebar-scroll
    .sidebar-section-label {

        display: none !important;
    }


    .shul-sidebar-scroll
    .sidebar-menu > li > a,
    .shul-sidebar-scroll
    .sidebar-menu > li.sub-menu > a {

        width: 100% !important;

        padding: 0 !important;

        min-height: 48px !important;

        display: flex !important;

        align-items: center !important;
        justify-content: center !important;

        gap: 0 !important;
    }


    /* Hide submenu when collapsed */

    .shul-sidebar-scroll
    .sidebar-menu li.sub-menu > ul.sub {

        display: none !important;
    }


    /* =====================================================
       EXPANDED SIDEBAR - ICON + TEXT
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    .sidebar-menu > li > a span,

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    .sidebar-menu > li.sub-menu > a span {

        display: inline !important;

        visibility: visible !important;

        opacity: 1 !important;
    }


    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    .sidebar-section-label {

        display: block !important;
    }


    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    .sidebar-menu > li > a,

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    .sidebar-menu > li.sub-menu > a {

        width: 100% !important;

        min-height: 46px !important;

        padding: 0 15px !important;

        display: flex !important;

        align-items: center !important;

        justify-content: flex-start !important;

        gap: 12px !important;
    }


    /* Show submenu after parent is opened */

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    .sidebar-menu li.sub-menu.open > ul.sub {

        display: block !important;
    }


    /* =====================================================
       EXPANDED SUBMENU
    ===================================================== */

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    ul.sub {

        width: 100% !important;
    }


    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll
    ul.sub a {

        display: flex !important;

        align-items: center !important;

        padding-left: 40px !important;

        min-height: 40px !important;
    }


    /* =====================================================
       BADGES
    ===================================================== */

    .shul-sidebar-scroll .badge {

        display: none !important;
    }


    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-scroll .badge {

        display: inline-flex !important;
    }


    /* =====================================================
       OVERLAY
    ===================================================== */

    .shul-sidebar-overlay {
        display: none !important;
    }

    .shul-app-layout.sidebar-mobile-open
    .shul-sidebar-overlay {

        display: block !important;

        position: fixed !important;

        top: 58px !important;

        left: 260px !important;

        right: 0 !important;

        bottom: 0 !important;

        background: rgba(0,0,0,.15) !important;

        z-index: 9997 !important;
    }

}

/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

    .shul-dashboard {
        padding-left: 10px;

        padding-right: 10px;
    }


    .shul-kpi-value {
        font-size: 22px;
    }


    .shul-kpi-value.expense {
        font-size: 19px;
    }


    .shul-alert-outer,
    .shul-chart-card {
        padding: 15px;
    }


    .shul-chart-box {
        height: 220px;
    }

}


/* =========================================================
   SMALL MOBILE
========================================================= */

@media (max-width: 420px) {

    .shul-dashboard {
        padding-left: 10px;

        padding-right: 10px;
    }


    .shul-kpi-value {
        font-size: 22px;
    }


    .shul-kpi-value.expense {
        font-size: 19px;
    }


    .shul-alert-outer,
    .shul-chart-card {
        padding: 15px;
    }


    .shul-chart-box {
        height: 220px;
    }

}