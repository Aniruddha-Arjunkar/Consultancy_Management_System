    // Custom search functionality (filter rows based on search input)
    function searchTable() {
        var input, filter, table, tr, td, i, txtValue;
        input = document.getElementById('txt_searchall');
        filter = input.value.toLowerCase();
        table = document.getElementById('rejectedCandidatesTable');
        tr = table.getElementsByTagName('tr');
        
        // Loop through all rows and hide those that don't match the search
        for (i = 1; i < tr.length; i++) { // Start from 1 to skip the header row
            td = tr[i].getElementsByTagName('td');
            var rowMatches = false;
            
            // Check each cell in the row to see if it matches the search query
            for (var j = 0; j < td.length; j++) {
                if (td[j]) {
                    txtValue = td[j].textContent || td[j].innerText;
                    if (txtValue.toLowerCase().indexOf(filter) > -1) {
                        rowMatches = true;
                    }
                }
            }

