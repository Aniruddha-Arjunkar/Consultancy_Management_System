  <script>
  document.addEventListener(
    "DOMContentLoaded",
    function () {
          const searchInput =
            document.getElementById(
                "txt_searchall"
            );
          const table =
            document.getElementById(
                "payments-table"
            );
          if (!searchInput || !table) {
            return;
        }
          searchInput.addEventListener(
            "input",
            function () {
                  const searchValue =
                    this.value
                        .toLowerCase()
                        .trim();
                  const rows =
                    table.querySelectorAll(
                        "tbody tr"
                    );
                  let serial = 1;
                  rows.forEach(
                    function (row) {
                          const noData =
                            row.querySelector(
                                ".view-client-no-data"
                            );
                          if (noData) {
                            return;
                        }
                          const rowText =
                            row.textContent
                                .toLowerCase();
                          if (
                            searchValue === ""
                            ||
                            rowText.includes(
                                searchValue
                            )
                        ) {
                              row.style.display = "";
                              const sr =
                                row.querySelector(
                                    ".view-client-sr"
                                );
                              if (sr) {
                                  sr.textContent =
                                    serial++;
                              }
                          } else {
                              row.style.display =
                                "none";
                          }
                      }
                );
              }
        );
      }
);
  document.addEventListener(
    "DOMContentLoaded",
    function () {
          document
            .querySelectorAll(
                ".action-toggle"
            )
            .forEach(
                function (button) {
                      button.addEventListener(
                        "click",
                        function () {
                              const actions =
                                this.nextElementSibling;
                              if (
                                actions.style.display ===
                                "block"
                            ) {
                                  actions.style.display =
                                    "none";
                              } else {
                                  document
                                    .querySelectorAll(
                                        ".action-buttons"
                                    )
                                    .forEach(
                                        function (item) {
                                              item.style.display =
                                                "none";
                                          }
                                    );
                                  actions.style.display =
                                    "block";
                              }
                          }
                    );
                  }
            );
      }
);
  document.addEventListener(
    "DOMContentLoaded",
    function () {
          const bottomScroll =
            document.getElementById(
                "viewClientBottomScroll"
            );
          const bottomInner =
            document.getElementById(
                "viewClientBottomScrollInner"
            );
          const tableWrapper =
            document.querySelector(
                ".view-clients-table-wrapper"
            );
          if (
            !bottomScroll ||
            !bottomInner ||
            !tableWrapper
        ) {
            return;
        }
          function updateScrollWidth() {
              bottomInner.style.width =
                tableWrapper.scrollWidth + "px";
          }
          updateScrollWidth();
          window.addEventListener(
            "resize",
            updateScrollWidth
        );
          bottomScroll.addEventListener(
            "scroll",
            function () {
                  tableWrapper.scrollLeft =
                    bottomScroll.scrollLeft;
              }
        );
          tableWrapper.addEventListener(
            "scroll",
            function () {
                  bottomScroll.scrollLeft =
                    tableWrapper.scrollLeft;
              }
        );
      }
);
  </script>
