  edit-gst-invoice ------> "<?php
session_start();
ob_start();
/* =========================
   LOGIN CHECK
========================= */
if (!isset($_SESSION['email'])) {
    $_SESSION['msg'] = "You must log in first";
    header('Location: login.php');
    exit();
}
/* =========================
   LOGOUT
========================= */
if (isset($_GET['logout'])) {
    session_destroy();
    unset($_SESSION['email']);
    header('Location: login.php');
    exit();
}
/* =========================
   DATABASE
========================= */
require_once 'db_connect.php';
include 'header.php';
/* =========================
   GET INVOICE ID
========================= */
$invoice_id = isset($_GET['id']) ? intval($_GET['id']) : 0;
if ($invoice_id <= 0) {
    echo "<script>
        alert('Invalid invoice ID');
        window.location.href='view-gst-client.php';
    </script>";
    exit();
}
/* =========================
   HANDLE FORM SUBMISSION
========================= */
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $invoice_id_post = intval($_POST['invoice_id'] ?? 0);
    $amount = floatval($_POST['amount'] ?? 0);
    $gst_type = trim($_POST['gst_type'] ?? '');
    $invoice_date = mysqli_real_escape_string(
        $conn,
        trim($_POST['invoice_date'] ?? '')
    );
    $comments = mysqli_real_escape_string(
        $conn,
        trim($_POST['comments'] ?? '')
    );
    /* =========================
       GST CALCULATION
    ========================= */
    $cgst = 0;
    $sgst = 0;
    $igst = 0;
    $total = 0;
    switch ($gst_type) {
        /* =====================
           EXCLUSIVE
        ===================== */
        case 'exclusive':
            $cgst = round($amount * 0.09, 2);
            $sgst = round($amount * 0.09, 2);
            $igst = 0;
            $total = $amount + $cgst + $sgst;
            break;
        /* =====================
           NORMAL
        ===================== */
        case 'normal':
            $cgst = 0;
            $sgst = 0;
            $igst = 0;
            $total = $amount;
            break;
        /* =====================
           INCLUSIVE
        ===================== */
        case 'inclusive':
            $cgst = round(
                ($amount / 1.18) * 0.09,
                2
            );
            $sgst = round(
                ($amount / 1.18) * 0.09,
                2
            );
            $igst = 0;
            $total = $amount;
            break;
        /* =====================
           IGST
        ===================== */
        case 'igst':
            $cgst = 0;
            $sgst = 0;
            $igst = round(
                $amount * 0.18,
                2
            );
            $total = $amount + $igst;
            break;
        default:
            echo "<script>
                alert('Invalid GST type');
                history.back();
            </script>";
            exit();
    }
    /* =========================
       VALIDATION
    ========================= */
    if ($invoice_id_post <= 0) {
        echo "<script>
            alert('Invalid invoice ID');
            history.back();
        </script>";
        exit();
    }
    if ($amount <= 0) {
        echo "<script>
            alert('Please enter a valid amount');
            history.back();
        </script>";
        exit();
    }
    if (empty($invoice_date)) {
        echo "<script>
            alert('Please select invoice date');
            history.back();
        </script>";
        exit();
    }
    /* =========================
       UPDATE INVOICE
    ========================= */
    $stmt = $conn->prepare("
        UPDATE tbl_gst_invoice
        SET
            gst_type = ?,
            amount = ?,
            cgst = ?,
            sgst = ?,
            igst = ?,
            total_amount = ?,
            invoice_date = ?,
            comments = ?
        WHERE id = ?
    ");
    if (!$stmt) {
        die(
            "Prepare failed: " .
            $conn->error
        );
    }
    $stmt->bind_param(
        "sdddddssi",
        $gst_type,
        $amount,
        $cgst,
        $sgst,
        $igst,
        $total,
        $invoice_date,
        $comments,
        $invoice_id_post
    );
    if (!$stmt->execute()) {
        die(
            "Update failed: " .
            $stmt->error
        );
    }
    /* =========================
       GET INVOICE NUMBER
    ========================= */
    $invNumQuery = $conn->prepare("
        SELECT invoice_number
        FROM tbl_gst_invoice
        WHERE id = ?
    ");
    $invNumQuery->bind_param(
        "i",
        $invoice_id_post
    );
    $invNumQuery->execute();
    $invNumResult =
        $invNumQuery->get_result();
    $invoiceData =
        $invNumResult->fetch_assoc();
    if (!$invoiceData) {
        die("Invoice number not found.");
    }
    $invoice_number =
        $invoiceData['invoice_number'];
    /* =========================
       REDIRECT TO PRINT
    ========================= */
    header(
        "Location: print-tax-invoice-edit.php?invoice_number=" .
        urlencode($invoice_number)
    );
    exit();
}
/* =========================
   FETCH SOURCE TYPE
========================= */
$stmt = $conn->prepare("
    SELECT source_type
    FROM tbl_gst_invoice
    WHERE id = ?
");
$stmt->bind_param(
    "i",
    $invoice_id
);
$stmt->execute();
$result =
    $stmt->get_result();
if ($result->num_rows === 0) {
    echo "<script>
        alert('Invoice not found');
        window.location.href='view-gst-client.php';
    </script>";
    exit();
}
$invoiceRow =
    $result->fetch_assoc();
$source_type =
    $invoiceRow['source_type'];
/* =========================
   FETCH RELATED ENTITY
========================= */
switch ($source_type) {
    /* =====================
       PEST CONTROL
    ===================== */
    case 'Pest Control':
        $query = "
            SELECT
                gi.*,
                c.gst_number,
                c.cust_name AS name
            FROM tbl_gst_invoice gi
            JOIN tbl_client c
                ON gi.entity_id = c.Id
            WHERE gi.id = ?
        ";
        break;
    /* =====================
       PLACEMENT
    ===================== */
    case 'Placement':
        $query = "
            SELECT
                gi.*,
                a.gst_number,
                a.name
            FROM tbl_gst_invoice gi
            JOIN tbl_agreement a
                ON gi.entity_id = a.Id
            WHERE gi.id = ?
        ";
        break;
    /* =====================
       CONSULTANT
    ===================== */
    case 'Consultant':
        $query = "
            SELECT
                gi.*,
                asoc.gst_number,
                asoc.company_name AS name
            FROM tbl_gst_invoice gi
            JOIN tbl_associate asoc
                ON gi.entity_id = asoc.Id
            WHERE gi.id = ?
        ";
        break;
    default:
        echo "<script>
            alert('Invalid source type');
            window.location.href='view-gst-client.php';
        </script>";
        exit();
}
/* =========================
   FETCH INVOICE
========================= */
$stmt = $conn->prepare($query);
$stmt->bind_param(
    "i",
    $invoice_id
);
$stmt->execute();
$result =
    $stmt->get_result();
if ($result->num_rows === 0) {
    echo "<script>
        alert('Invoice not found');
        window.location.href='view-gst-client.php';
    </script>";
    exit();
}
$row =
    $result->fetch_assoc();
?>
