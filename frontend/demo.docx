<?php 
session_start(); 
 
// Check if user is logged in 
if (!isset($_SESSION['email'])) { 
    $_SESSION['msg'] = "You must log in first"; 
    header('location:login.php'); 
    exit(); 
} 
 
require_once 'db_connect.php'; 
include 'header.php'; 
 
// Check if id and status are set in GET 
if (isset($_GET['id']) && isset($_GET['status'])) { 
    $interview_id = intval($_GET['id']); 
    $status = mysqli_real_escape_string($conn, $_GET['status']); 
 
    if ($status == 'Placed') { 
        // If form submitted 
        if ($_SERVER['REQUEST_METHOD'] == 'POST') { 
            $candidate_name = mysqli_real_escape_string($conn, $_POST['candidate_name']);
            $salary_package = mysqli_real_escape_string($conn, $_POST['salary_package']); 
            $joining_date = mysqli_real_escape_string($conn, $_POST['joining_date']); 
            $payment_type = mysqli_real_escape_string($conn, $_POST['payment_type']); 
 
            // Base amounts (nullable) 
            $company_pay_amount = isset($_POST['company_pay_amount']) && $_POST['company_pay_amount'] !== '' 
                ? floatval($_POST['company_pay_amount']) 
                : null; 
 
            $company_pay_date = isset($_POST['company_pay_date']) 
                ? mysqli_real_escape_string($conn, $_POST['company_pay_date']) 
                : null; 
 
            $company_gst_applicable = isset($_POST['company_gst_applicable']); 
 
            $candidate_pay_amount = isset($_POST['candidate_pay_amount']) && $_POST['candidate_pay_amount'] !== '' 
                ? floatval($_POST['candidate_pay_amount']) 
                : null; 
 
            $candidate_pay_date = isset($_POST['candidate_pay_date']) 
                ? mysqli_real_escape_string($conn, $_POST['candidate_pay_date']) 
                : null; 
 
            $candidate_gst_applicable = isset($_POST['candidate_gst_applicable']); 
 
            // Calculate GST amounts 
            $company_gst_amount = ($company_gst_applicable && $company_pay_amount !== null) 
                ? round($company_pay_amount * 0.18, 2) 
                : 0; 
 
            $candidate_gst_amount = ($candidate_gst_applicable && $candidate_pay_amount !== null) 
                ? round($candidate_pay_amount * 0.18, 2) 
                : 0; 
 
            // Get candidate_id from tbl_placement for this interview 
            $candidate_query = "SELECT candidate_id, candidate_name FROM tbl_placement WHERE interview_id = $interview_id"; 
            $candidate_result = mysqli_query($conn, $candidate_query); 
 
            if ($candidate_result && mysqli_num_rows($candidate_result) > 0) { 
                $candidate_data = mysqli_fetch_assoc($candidate_result); 
                $candidate_id = $candidate_data['candidate_id']; 
            } else { 
                echo "Error: Candidate not found for this interview."; 
                exit(); 
            } 
 
            // Update tbl_placement 
            $update_sql = "UPDATE tbl_placement SET  
                candidate_name = '$candidate_name',
                interview_status = '$status',  
                salary_package = '$salary_package',  
                joining_date = '$joining_date',  
                payment_type = '$payment_type',  
                company_pay_amount = " . ($company_pay_amount !== null ? "'$company_pay_amount'" : "NULL") . ",  
                company_gst_amount = " . ($company_gst_amount > 0 ? "'$company_gst_amount'" : "NULL") . ",  
                company_pay_date = " . ($company_pay_date ? "'$company_pay_date'" : "NULL") . ",  
                candidate_pay_amount = " . ($candidate_pay_amount !== null ? "'$candidate_pay_amount'" : "NULL") . ",  
                candidate_gst_amount = " . ($candidate_gst_amount > 0 ? "'$candidate_gst_amount'" : "NULL") . ",  
                candidate_pay_date = " . ($candidate_pay_date ? "'$candidate_pay_date'" : "NULL") . " 
                WHERE interview_id = $interview_id"; 
 
            if (mysqli_query($conn, $update_sql)) { 
 
                // Insert company payment if applicable 
                if (($payment_type == 'Company Pay' || $payment_type == 'Both Pay') && $company_pay_amount !== null) { 
                    $total_company_pay = $company_pay_amount + $company_gst_amount; 
 
                    $sql = "INSERT INTO tbl_payment 
                        (client_id, interview_id, payment_type, total_amount, due_date) 
                        VALUES  
                        ($candidate_id, $interview_id, 'Company Pay', $total_company_pay, " 
                        . ($company_pay_date ? "'$company_pay_date'" : "NULL") . ")"; 
 
                    mysqli_query($conn, $sql); 
                } 
 
                // Insert candidate payment if applicable 
                if (($payment_type == 'Candidate Pay' || $payment_type == 'Both Pay') && $candidate_pay_amount !== null) { 
                    $total_candidate_pay = $candidate_pay_amount + $candidate_gst_amount; 
 
                    $sql = "INSERT INTO tbl_payment 
                        (client_id, interview_id, payment_type, total_amount, due_date) 
                        VALUES  
                        ($candidate_id, $interview_id, 'Candidate Pay', $total_candidate_pay, " 
                        . ($candidate_pay_date ? "'$candidate_pay_date'" : "NULL") . ")"; 
 
                    mysqli_query($conn, $sql); 
                } 
 
                echo "<script>
                    alert('Candidate placed successfully with GST and payment details.'); 
                    window.location.href='view-interview-schedule-student.php';
                </script>"; 
                exit(); 
 
            } else { 
                echo "Error updating placement: " . mysqli_error($conn); 
            } 
        } 
 
    } else { 
 
        // For other statuses 
        $sql = "UPDATE tbl_placement SET interview_status = '$status' WHERE interview_id = $interview_id"; 
 
        if (mysqli_query($conn, $sql)) { 
            echo "<script>
                alert('Status updated successfully.'); 
                window.location.href='view-interview-schedule-student.php';
            </script>"; 
            exit(); 
        } else { 
            echo "Error updating status: " . mysqli_error($conn); 
        } 
    } 
 
} else { 
    echo "Invalid request."; 
} 
 
mysqli_close($conn); 
?>


